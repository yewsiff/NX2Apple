+    (0x249190, 27, 'f81b0ffc', "NEX login job entry: the job in x0; the host points its NgsFacade at the Nextendo bridge (OBS_NEX_LOGIN)"),
+  ],
+}
 region = 'engine region 62 GB → 4 GB (11 instructions in four functions)'
