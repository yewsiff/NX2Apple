+// Shows the sign-in page and waits for the redirect. With g_acc_m held. 1 when signed in
+static int sign_in(void) {
+    if (!C.client_id[0]) { LOG("[nextendo] no client ID: register an application at nextendo.network/developers and set DM_NEXTENDO_CLIENT_ID (docs/nextendo.md)"); return 0; }
+    int ls = socket(AF_INET, SOCK_STREAM, 0);
+    int one = 1; setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+    struct sockaddr_in a = {.sin_len = sizeof a, .sin_family = AF_INET, .sin_port = htons((uint16_t)C.redirect_port), .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};
+    if (ls < 0 || bind(ls, (struct sockaddr *)&a, sizeof a) || listen(ls, 4)) {
+        LOG("[nextendo] cannot listen on 127.0.0.1:%d for the sign-in redirect (%s)", C.redirect_port, strerror(errno));
+        if (ls >= 0) close(ls);
+        return 0;
+    }
+    NSString *verifier = b64url(random_data(32)), *state = b64url(random_data(16));
+    NSString *challenge = b64url(sha256([verifier dataUsingEncoding:NSUTF8StringEncoding]));
+    NSString *redirect = [NSString stringWithFormat:@"http://127.0.0.1:%d/callback", C.redirect_port];
+    NSString *url = [NSString stringWithFormat:@"%s/oauth/authorize?response_type=code&client_id=%@&redirect_uri=%@&scope=%@&state=%@&code_challenge=%@&code_challenge_method=S256",
+                     C.api, form_escape(@(C.client_id)), form_escape(redirect), form_escape(NX_SCOPE), state, challenge];
+    g_wait_state = state; g_got_code = nil; g_got_error = nil;
+    g_signin_done = dispatch_semaphore_create(0);
+    int old = atomic_exchange(&g_listen_fd, ls);
+    if (old >= 0) close(old);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{ listener_thread(ls); });
+    LOG("[nextendo] sign in to Nextendo in the browser that opens");
+    NSURL *u = [NSURL URLWithString:url];
+    dispatch_async(dispatch_get_main_queue(), ^{
+#if TARGET_OS_IPHONE
+        // The sheet's own callback scheme is never used: the redirect goes to the loopback listener, which then closes the sheet
+        g_anchor = [NxSheetAnchor new];
+        g_sheet = [[ASWebAuthenticationSession alloc] initWithURL:u callbackURLScheme:@"nx2apple-nextendo" completionHandler:^(NSURL *cb, NSError *e) {
+            (void)cb;
+            if (e && !g_got_code) { g_got_error = @"cancelled"; dispatch_semaphore_signal(g_signin_done); }
+        }];
+        g_sheet.presentationContextProvider = g_anchor;
+        if (![g_sheet start]) { g_got_error = @"the sign-in sheet did not open"; dispatch_semaphore_signal(g_signin_done); }
+#else
+        if (![NSWorkspace.sharedWorkspace openURL:u]) { g_got_error = @"no browser opened"; dispatch_semaphore_signal(g_signin_done); }
+#endif
+    });
+    int timed_out = wait_sem(g_signin_done, NX_SIGNIN_TIMEOUT_S) != 0;
+    int cur = ls;
+    if (atomic_compare_exchange_strong(&g_listen_fd, &cur, -1)) close(ls);
+#if TARGET_OS_IPHONE
+    dispatch_async(dispatch_get_main_queue(), ^{ [g_sheet cancel]; g_sheet = nil; g_anchor = nil; });
+#endif
+    NSString *code = g_got_code;
+    g_got_code = nil;
+    if (!code.length) { LOG("[nextendo] sign-in not completed (%s)", timed_out ? "timed out" : g_got_error.UTF8String ?: "no code"); return 0; }
+    NSString *form = [NSString stringWithFormat:@"grant_type=authorization_code&client_id=%@&code=%@&redirect_uri=%@&code_verifier=%@",
+                      form_escape(@(C.client_id)), form_escape(code), form_escape(redirect), form_escape(verifier)];
+    NSDictionary *j = nil;
+    int st = token_request(form, &j);
+    if (st != 200 || !take_tokens(j) || !A.refresh.length) { LOG("[nextendo] sign-in: the token exchange failed (HTTP %d%s%s)", st, jstr(j, @"error") ? ", " : "", jstr(j, @"error").UTF8String ?: ""); return 0; }
+    LOG("[nextendo] signed in");
+    return 1;
+}
+static int ensure_access(void) {   // with g_acc_m held
+    if (A.access.length && A.access_exp - time(NULL) > NX_ACCESS_MIN_LEFT_S) return 1;
+    if (!A.refresh.length) return 0;
+    NSDictionary *j = nil;
+    int st = token_request([NSString stringWithFormat:@"grant_type=refresh_token&refresh_token=%@&client_id=%@", form_escape(A.refresh), form_escape(@(C.client_id))], &j);
+    if (st == 200 && take_tokens(j)) return 1;
+    if (st == 400 || st == 401) acc_forget(jstr(j, @"error").UTF8String ?: "refused");
+    else LOG("[nextendo] could not refresh the sign-in (HTTP %d)", st);
+    return 0;
+}
+static int fetch_nex(void) {   // with g_acc_m held
+    NSDictionary *j = nil;
+    int st = http(@"GET", [@(C.api) stringByAppendingString:@"/api/nex-token"], A.access, nil, &j);
+    NSString *nt = jstr(j, @"nex_token"), *un = jstr(j, @"username");
+    double pid = jnum(j, @"pid", 0);
+    if (st == 401) { A.access = nil; return 0; }
+    if (st != 200 || !nt.length || pid <= 0 || nt.length > 1024) { LOG("[nextendo] no game token (HTTP %d)", st); return 0; }
+    for (NSUInteger i = 0; i < nt.length; i++) { unichar ch = [nt characterAtIndex:i]; if (ch <= ' ' || ch == '"' || ch == '\\' || ch > 126) { LOG("[nextendo] the game token is not a token"); return 0; } }
+    A.nex = nt; A.pid = (uint64_t)pid;
+    A.nex_exp = time(NULL) + (time_t)jnum(j, @"expires_in", 3600);
+    if (un.length && ![un isEqualToString:A.username]) { A.username = un; kc_set_str(@"username", un); }
+    LOG("[nextendo] game token ready (%s)", A.username.UTF8String ?: "signed in");
+    return 1;
+}
+static int account_ready(void) {
+    pthread_mutex_lock(&g_acc_m);
+    acc_load();
+    int ok = A.nex.length && A.nex_exp - time(NULL) > NX_NEX_MIN_LEFT_S;
+    for (int attempt = 0; !ok && attempt < 2; attempt++) {
+        if (!A.refresh.length && !sign_in()) break;
+        if (!ensure_access()) continue;   // (a refused refresh token forgot the account: the second attempt signs in)
+        ok = fetch_nex();
+    }
+    pthread_mutex_unlock(&g_acc_m);
+    return ok;
+}
+int nx_account_ready(int timeout_ms) {
+    (void)timeout_ms;   // each step has its own bound: the sign-in 5 minutes, each request NX_HTTP_TIMEOUT_S
+    if (!dm_net_online()) return 0;
+    __block int ok = 0;
+    on_host_thread(^{ ok = account_ready(); });
+    return ok;
+}
+static int username_(char *out, size_t cap);
+uint64_t nx_pid(void) { pthread_mutex_lock(&g_acc_m); uint64_t p = A.pid; pthread_mutex_unlock(&g_acc_m); return p; }
+int nx_username(char *out, size_t cap) {
+    __block int r = 0;
+    on_host_thread(^{ r = username_(out, cap); });
+    return r;
+}
+static int username_(char *out, size_t cap) {
+    pthread_mutex_lock(&g_acc_m);
+    acc_load();
+    int ok = A.username.length > 0;
+    if (ok) snprintf(out, cap, "%s", A.username.UTF8String);
+    pthread_mutex_unlock(&g_acc_m);
+    return ok;
+}
+
+// ---------- the ID token ----------
+#define NX_BAAS_ISS "https://e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com"
+#define NX_BAAS_AUD "ed9e2f05d286f7b8"   // the network service account's client ID that BaaS ID tokens name
+static SecKeyRef g_jwt_key; static NSString *g_device_id;
+static int jwt_key_load(void) {   // with g_acc_m held
+    if (g_jwt_key) return 1;
+    NSData *der = kc_get(@"jwt_key");
+    NSDictionary *attrs = @{(__bridge id)kSecAttrKeyType: (__bridge id)kSecAttrKeyTypeRSA, (__bridge id)kSecAttrKeyClass: (__bridge id)kSecAttrKeyClassPrivate};
+    if (der) g_jwt_key = SecKeyCreateWithData((__bridge CFDataRef)der, (__bridge CFDictionaryRef)attrs, NULL);
+    if (!g_jwt_key) {
+        CFErrorRef e = NULL;
+        g_jwt_key = SecKeyCreateRandomKey((__bridge CFDictionaryRef)@{(__bridge id)kSecAttrKeyType: (__bridge id)kSecAttrKeyTypeRSA,
+                                                                      (__bridge id)kSecAttrKeySizeInBits: @2048}, &e);
+        if (!g_jwt_key) { LOG("[nextendo] could not make the ID token's key"); if (e) CFRelease(e); return 0; }
+        CFDataRef ext = SecKeyCopyExternalRepresentation(g_jwt_key, NULL);
+        if (ext) { kc_set(@"jwt_key", (__bridge NSData *)ext); CFRelease(ext); }
+    }
+    g_device_id = kc_str(@"device_id");
+    if (g_device_id.length != 16) {
+        const uint8_t *b = random_data(8).bytes;
+        g_device_id = [NSString stringWithFormat:@"%02x%02x%02x%02x%02x%02x%02x%02x", b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]];
+        kc_set_str(@"device_id", g_device_id);
+    }
+    return 1;
+}
+static size_t id_token_(char *out, size_t cap);
+size_t nx_id_token(char *out, size_t cap) {
+    if (!dm_net_online() || !cap) return 0;
+    __block size_t n = 0;
+    on_host_thread(^{ n = id_token_(out, cap); });
+    return n;
+}
+static size_t id_token_(char *out, size_t cap) {
+    pthread_mutex_lock(&g_acc_m);
+    size_t n = 0;
+    if (A.nex.length && A.pid && jwt_key_load()) {
+        long long now = (long long)time(NULL);
+        NSString *jti = NSUUID.UUID.UUIDString.lowercaseString;
+        unsigned long long tid = strtoull(dm_profile()->id, NULL, 16);
+        NSString *claims = [NSString stringWithFormat:
+            @"{\"iss\":\"" NX_BAAS_ISS "\",\"jku\":\"" NX_BAAS_ISS "/1.0.0/certificates\",\"aud\":\"" NX_BAAS_AUD "\",\"sub\":\"%016llx\",\"iat\":%lld,\"exp\":%lld,"
+             "\"jti\":\"%@\",\"typ\":\"id_token\",\"di\":\"%@\",\"bs:did\":\"%@\",\"sn\":\"XAW10000000000\",\"hm\":true,\"nintendo\":{\"ai\":\"%016llx\",\"av\":\"%s\"},"
+             "\"tv\":\"%s\",\"nnex\":\"%@\"}",
+            (unsigned long long)A.pid, now, now + 3 * 3600, jti, g_device_id, g_device_id, tid, nx_game_version(), nx_game_version(), A.nex];
+        NSString *header = @"{\"alg\":\"RS256\",\"typ\":\"JWT\",\"kid\":\"nextendo-baas-key-1\"}";
+        NSString *signing = [NSString stringWithFormat:@"%@.%@", b64url([header dataUsingEncoding:NSUTF8StringEncoding]), b64url([claims dataUsingEncoding:NSUTF8StringEncoding])];
+        CFDataRef sig = SecKeyCreateSignature(g_jwt_key, kSecKeyAlgorithmRSASignatureMessagePKCS1v15SHA256, (__bridge CFDataRef)[signing dataUsingEncoding:NSUTF8StringEncoding], NULL);
+        if (sig) {
+            NSString *tok = [NSString stringWithFormat:@"%@.%@", signing, b64url((__bridge NSData *)sig)];
+            CFRelease(sig);
+            const char *t = tok.UTF8String;
+            if (strlen(t) < cap) { memcpy(out, t, strlen(t) + 1); n = strlen(t); }
+            else LOG("[nextendo] the ID token (%zu bytes) does not fit the game's buffer (%zu)", strlen(t), cap);
+        }
+    }
+    pthread_mutex_unlock(&g_acc_m);
+    if (!n) out[0] = 0;
+    return n;
+}
+
+// ---------- the TLS bridge ----------
+// The game's end is a stream socket of a socketpair; the host's end is read with a dispatch source and written to a Network.framework TLS
+// connection to the game server, whose key must hash to the pin. Until the TLS connection is ready, what the game sends waits. The first
+// request (the WebSocket upgrade, sent to the stand-in address) gets the game server's real name as its Host.
+static NSData *spki_der(SecKeyRef key) {   // the key's SubjectPublicKeyInfo, as DER: what a pin hashes
+    CFDataRef raw = SecKeyCopyExternalRepresentation(key, NULL);
+    if (!raw) return nil;
+    NSData *k = (__bridge_transfer NSData *)raw;
+    NSDictionary *at = (__bridge_transfer NSDictionary *)SecKeyCopyAttributes(key);
+    NSString *type = at[(__bridge id)kSecAttrKeyType];
+    int bits = [at[(__bridge id)kSecAttrKeySizeInBits] intValue];
+    static const uint8_t rsa[] = {0x30, 0x0d, 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01, 0x05, 0x00};
+    static const uint8_t p256[] = {0x30, 0x13, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07};
+    static const uint8_t p384[] = {0x30, 0x10, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01, 0x06, 0x05, 0x2b, 0x81, 0x04, 0x00, 0x22};
+    const uint8_t *alg; size_t alen;
+    if ([type isEqualToString:(__bridge NSString *)kSecAttrKeyTypeRSA]) { alg = rsa; alen = sizeof rsa; }
+    else if ([type isEqualToString:(__bridge NSString *)kSecAttrKeyTypeECSECPrimeRandom] && bits == 256) { alg = p256; alen = sizeof p256; }
+    else if ([type isEqualToString:(__bridge NSString *)kSecAttrKeyTypeECSECPrimeRandom] && bits == 384) { alg = p384; alen = sizeof p384; }
+    else return nil;
+    void (^len)(NSMutableData *, size_t) = ^(NSMutableData *d, size_t n) {
+        uint8_t b[5]; size_t m = 0;
+        if (n < 0x80) b[m++] = (uint8_t)n;
+        else { size_t t = n; int k2 = 0; while (t) { k2++; t >>= 8; } b[m++] = (uint8_t)(0x80 | k2); for (int i = k2 - 1; i >= 0; i--) b[m++] = (uint8_t)(n >> (8 * i)); }
+        [d appendBytes:b length:m];
+    };
+    NSMutableData *bit = [NSMutableData data]; uint8_t tag = 0x03, zero = 0;
+    [bit appendBytes:&tag length:1]; len(bit, k.length + 1); [bit appendBytes:&zero length:1]; [bit appendData:k];
+    NSMutableData *out = [NSMutableData data]; uint8_t seq = 0x30;
+    [out appendBytes:&seq length:1]; len(out, alen + bit.length); [out appendBytes:alg length:alen]; [out appendData:bit];
+    return out;
+}
+static int trust_matches_pin(sec_trust_t trust) {
+    SecTrustRef t = sec_trust_copy_ref(trust);
+    if (!t) return 0;
+    int ok = 0;
+    if (SecTrustGetCertificateCount(t) > 0) {
+        SecKeyRef k = SecTrustCopyKey(t);
+        NSData *spki = k ? spki_der(k) : nil;
+        if (k) CFRelease(k);
+        ok = spki && !memcmp(sha256(spki).bytes, C.pin, 32);
+    }
+    CFRelease(t);
+    return ok;
+}
+
+@interface NxBridge : NSObject
+@end
+@implementation NxBridge {
+@public
+    int fd;
+    dispatch_queue_t q;
+    dispatch_source_t rd;
+    nw_connection_t conn;
+    NSMutableData *pending;   // what the game sent before the connection was ready, or the first request while its header is incomplete
+    int ready, closed, header_done;
+}
+- (void)close {
+    if (closed) return;
+    closed = 1;
+    if (rd) { dispatch_source_cancel(rd); rd = nil; } else if (fd >= 0) close(fd);
+    if (conn) nw_connection_cancel(conn);
+    conn = nil;
+}
+// The first request's header: its Host line names the game server
+- (NSData *)fixHeader:(NSData *)req {
+    NSString *s = [[NSString alloc] initWithData:req encoding:NSISOLatin1StringEncoding];
+    NSMutableArray *lines = [[s componentsSeparatedByString:@"\r\n"] mutableCopy];
+    for (NSUInteger i = 1; i < lines.count; i++)
+        if ([[lines[i] lowercaseString] hasPrefix:@"host:"]) { lines[i] = [@"Host: " stringByAppendingString:@(nx_game_host())]; break; }
+    return [[lines componentsJoinedByString:@"\r\n"] dataUsingEncoding:NSISOLatin1StringEncoding];
+}
+- (void)upstream:(NSData *)d {
+    if (closed) return;
+    if (!header_done) {
+        if (d) [pending appendData:d];
+        NSRange end = [pending rangeOfData:[NSData dataWithBytes:"\r\n\r\n" length:4] options:0 range:NSMakeRange(0, pending.length)];
+        if (end.location == NSNotFound) { if (pending.length > 16384) header_done = 1; else return; }
+        else {
+            NSData *head = [self fixHeader:[pending subdataWithRange:NSMakeRange(0, end.location + 4)]];
+            NSMutableData *rest = [head mutableCopy];
+            [rest appendData:[pending subdataWithRange:NSMakeRange(end.location + 4, pending.length - end.location - 4)]];
+            pending = rest; header_done = 1;
+        }
+        d = nil;
+    } else if (!ready) { if (d) [pending appendData:d]; return; }
+    if (!ready) return;
+    NSData *out = d;
+    if (pending.length) { NSMutableData *m = pending; if (d) [m appendData:d]; out = m; pending = [NSMutableData data]; }
+    if (!out.length) return;
+    dispatch_data_t dd = dispatch_data_create(out.bytes, out.length, q, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+    nw_connection_send(conn, dd, NW_CONNECTION_DEFAULT_MESSAGE_CONTEXT, true, ^(nw_error_t e) { if (e) { NXLOG("bridge: send failed"); [self close]; } });
+}
+- (void)receive {
+    if (closed) return;
+    nw_connection_receive(conn, 1, 65536, ^(dispatch_data_t content, nw_content_context_t ctx, bool complete, nw_error_t e) {
+        (void)ctx;
+        if (closed) return;
+        if (content) {
+            __block int bad = 0;
+            dispatch_data_apply(content, ^bool(dispatch_data_t region, size_t off, const void *buf, size_t size) {
+                (void)region; (void)off;
+                const uint8_t *p = buf;
+                while (size) {   // the game's end is a local socket: a short wait at most when its buffer is full
+                    ssize_t w = write(self->fd, p, size);
+                    if (w > 0) { p += w; size -= (size_t)w; continue; }
+                    if (w < 0 && (errno == EAGAIN || errno == EINTR)) { struct timespec ts = {0, 1000000}; nanosleep(&ts, NULL); continue; }
+                    bad = 1; return false;
+                }
+                return true;
+            });
+            if (bad) { [self close]; return; }
+        }
+        if (e || (complete && !content)) { NXLOG("bridge: the game server closed the connection"); [self close]; return; }
+        [self receive];
+    });
+}
+@end
+
+static NSMutableSet *g_bridges;   // keeps each bridge alive until it closes (on its own queue)
+
+static int bridge_open_(void);
+int nx_bridge_open(void) {
+    if (!dm_net_online()) { errno = ENETDOWN; return -1; }
+    __block int fd = -1, err = 0;
+    on_host_thread(^{ fd = bridge_open_(); err = errno; });
+    if (fd < 0) errno = err;
+    return fd;
+}
+static int bridge_open_(void) {
+    int sv[2];
+    if (socketpair(AF_UNIX, SOCK_STREAM, 0, sv)) return -1;
+    int nos = 1;
+    setsockopt(sv[0], SOL_SOCKET, SO_NOSIGPIPE, &nos, sizeof nos);
+    setsockopt(sv[1], SOL_SOCKET, SO_NOSIGPIPE, &nos, sizeof nos);
+    fcntl(sv[1], F_SETFL, fcntl(sv[1], F_GETFL) | O_NONBLOCK);
+    NxBridge *b = [NxBridge new];
+    b->fd = sv[1];
+    b->q = dispatch_queue_create("nextendo.bridge", DISPATCH_QUEUE_SERIAL);
+    b->pending = [NSMutableData data];
+    char ip[16];
+    struct in_addr ia = {htonl(C.server)};
+    inet_ntop(AF_INET, &ia, ip, sizeof ip);
+    char port[8]; snprintf(port, sizeof port, "%u", C.server_port);
+    nw_endpoint_t ep = nw_endpoint_create_host(ip, port);
+    nw_parameters_t params = nw_parameters_create_secure_tcp(^(nw_protocol_options_t tls) {
+        sec_protocol_options_t so = nw_tls_copy_sec_protocol_options(tls);
+        sec_protocol_options_set_tls_server_name(so, nx_game_host());
+        sec_protocol_options_set_min_tls_protocol_version(so, tls_protocol_version_TLSv12);
+        sec_protocol_options_set_verify_block(so, ^(sec_protocol_metadata_t md, sec_trust_t trust, sec_protocol_verify_complete_t complete) {
+            (void)md;
+            int ok = trust_matches_pin(trust);
+            if (!ok) LOG("[nextendo] the game server's key does not match the pin (DM_NEXTENDO_PIN): not connecting");
+            complete(ok);
+        }, b->q);
+    }, ^(nw_protocol_options_t tcp) { nw_tcp_options_set_no_delay(tcp, true); });
+    b->conn = nw_connection_create(ep, params);
+    nw_connection_set_queue(b->conn, b->q);
+    @synchronized (NxBridge.class) { if (!g_bridges) g_bridges = [NSMutableSet set]; [g_bridges addObject:b]; }
+    __weak NxBridge *wb = b;
+    nw_connection_set_state_changed_handler(b->conn, ^(nw_connection_state_t st, nw_error_t e) {
+        NxBridge *s = wb; if (!s) return;
+        if (st == nw_connection_state_ready) {
+            NXLOG("bridge: TLS to the game server is up");
+            s->ready = 1;
+            [s upstream:nil];
+            [s receive];
+        } else if (st == nw_connection_state_failed || st == nw_connection_state_waiting) {
+            LOG("[nextendo] cannot reach the game server (%s)", e ? "error" : "waiting");
+            [s close];
+        } else if (st == nw_connection_state_cancelled) {
+            @synchronized (NxBridge.class) { [g_bridges removeObject:s]; }
+        }
+    });
+    b->rd = dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, (uintptr_t)sv[1], 0, b->q);
+    int hostfd = sv[1];
+    dispatch_source_set_event_handler(b->rd, ^{
+        NxBridge *s = wb; if (!s) return;
+        uint8_t buf[65536];
+        ssize_t n = read(hostfd, buf, sizeof buf);
+        if (n > 0) [s upstream:[NSData dataWithBytes:buf length:(size_t)n]];
+        else if (n == 0 || (errno != EAGAIN && errno != EINTR)) { NXLOG("bridge: the game closed its end"); [s close]; }
+    });
+    dispatch_source_set_cancel_handler(b->rd, ^{ close(hostfd); });
+    dispatch_resume(b->rd);
+    nw_connection_start(b->conn);
+    NXLOG("bridge: connecting to the game server");
+    return sv[0];
+}
