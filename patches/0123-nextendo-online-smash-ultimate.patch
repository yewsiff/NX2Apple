+#define NX_KC_SERVICE @"nx2apple.nextendo"
+#define NX_SCOPE @"identity game.matchmaking"
+#define NX_SIGNIN_TIMEOUT_S 300
+#define NX_NEX_MIN_LEFT_S 3600     // fetch the game token again when less than this is left
+#define NX_ACCESS_MIN_LEFT_S 60
+#define NX_HTTP_TIMEOUT_S 15
