+// The game's NEX login job (observation gate OBS_NEX_LOGIN, dm/games/01006A800016E000/patches.py): its NgsFacade is at +360 of the job (x0). The facade
+// can carry a direct server address, which no retail code sets: the host at +576 (an nn::nex::String: its characters' pointer at +24 and its capacity at
+// +32) and the port at +616. Set, NEX opens its WebSocket to that address without TLS, and the bridge (net_nextendo_apple.m) adds the TLS. Facts of
+// Super Smash Bros. Ultimate 13.0.5, as WindowSmash found them (github.com/OpenSmash-Ultimate/WindowSmash, runtime/hle_online.c)
+static void obs_nex_login(uint64_t *regs, int param) {
+    (void)param;
+    if (!dm_net_online() || !regs[0]) return;
+    uint8_t *facade = *(uint8_t **)(regs[0] + 360);
+    if (!facade) return;
+    char *data = *(char **)(facade + 576 + 24);
+    uint64_t cap = *(uint64_t *)(facade + 576 + 32);
+    const char host[] = "10.13.37.1";   // NX_BRIDGE_IP
+    if (!data || cap <= strlen(host)) { LOG("[nextendo] NEX login: no room for the bridge's address; the game's own server is left, and its login fails"); return; }
+    memcpy(data, host, sizeof host);
+    *(uint16_t *)(facade + 616) = NX_BRIDGE_PORT;
+    NXLOG("NEX login through the bridge");
+    nx_account_ready(0);   // signs in now if needed, before the login asks for the ID token
+}
+__attribute__((constructor)) static void net_obs_init(void) { gate_obs_set(OBS_NEX_LOGIN, obs_nex_login); }
