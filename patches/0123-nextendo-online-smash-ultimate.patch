+// ---------- online: names ----------
+// nn::socket::AddrInfo is FreeBSD's addrinfo or POSIX's, which differ in the order of ai_canonname and ai_addr: both words point at the address, so
+// either reading finds it (as a name it is a short string, ended by sin_zero)
+typedef struct { int32_t flags, family, socktype, protocol; uint32_t addrlen, pad; void *p1, *p2; void *next; sk_in addr; } sk_addrinfo;
+static int on_getaddrinfo(const char *host, const char *serv, const void *hint, void **res) {
+    uint32_t ip;
+    if (res) *res = NULL;
+    if (!host || !nx_resolve(host, &ip)) return 8;   // EAI_NONAME
+    int32_t h[4] = {0, SK_AF_INET, SK_SOCK_STREAM, 0};
+    if (hint) memcpy(h, hint, sizeof h);
+    sk_addrinfo *ai = calloc(1, sizeof *ai);
+    if (!ai) return 6;   // EAI_MEMORY
+    ai->family = SK_AF_INET; ai->socktype = h[2] ? h[2] : SK_SOCK_STREAM; ai->protocol = h[3]; ai->addrlen = sizeof ai->addr;
+    ai->addr = (sk_in){sizeof ai->addr, SK_AF_INET, htons((uint16_t)(serv ? atoi(serv) : 0)), htonl(ip), {0}};
+    ai->p1 = ai->p2 = &ai->addr;
+    if (res) *res = ai; else free(ai);
+    return 0;
+}
+typedef struct { char *name; char **aliases; int32_t addrtype, length; char **addr_list; } sk_hostent;
+static void *on_gethostbyname(const char *name) {
+    static __thread struct { sk_hostent he; char *alias0, *list[2]; uint32_t addr; char name[256]; } t;
+    uint32_t ip;
+    if (!name || !nx_resolve(name, &ip)) { t_skerr = 1; return NULL; }   // h_errno HOST_NOT_FOUND
+    snprintf(t.name, sizeof t.name, "%s", name);
+    t.addr = htonl(ip); t.alias0 = NULL; t.list[0] = (char *)&t.addr; t.list[1] = NULL;
+    t.he = (sk_hostent){t.name, &t.alias0, SK_AF_INET, 4, t.list};
+    return &t.he;
+}
