From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yewsifofficial <yewsifofficial@gmail.com>
Date: Tue, 10 Nov 2026 16:05:10 -0500
Subject: [PATCH] net: implement nn::socket::Ioctl (FIONBIO, FIONREAD), which
 nothing here handled

With connect, bind, getsockname, setsockopt, fcntl, poll, send and recv all
traced, the match attempt shows Pia creating a UDP socket and closing it
again with no traced call in between, five times, then the game reports an
unstable network connection. Ioctl was the one socket call this host never
hooked at all, and sm35recomp implements exactly two requests for it
(bsd_host.c): FIONBIO to set non-blocking and FIONREAD for what is readable.
Pia makes its NAT-check socket non-blocking that way rather than with Fcntl,
which is why nothing traced appeared.

The two requests are implemented, any other succeeds without doing anything,
and the hook is declared in the SDK's two C++ forms and the C one, since
which the game imports is not known from here; an unused entry is only
counted as unreferenced ("force: N entries hit").

Upstream-Status: fork-only (online play is out of nxnative's scope)
Reason: Pia NAT traversal for Super Smash Bros. Ultimate on Nextendo
Issue: yewsiff/NX2Apple (no tracker: issues are disabled on this fork)

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017xdHQoEipBX2wTqN8BNnMv
---
 dm/host/hle_net.c | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/dm/host/hle_net.c b/dm/host/hle_net.c
index 68bffbb..30c7b54 100644
--- a/dm/host/hle_net.c
+++ b/dm/host/hle_net.c
@@ -12,6 +12,7 @@
 #include <poll.h>
 #include <pthread.h>
 #include <stdatomic.h>
+#include <sys/ioctl.h>
 #include <sys/socket.h>
 #include <unistd.h>
 
@@ -528,6 +529,31 @@ static int on_fcntl(int fd, int cmd, int val) {
     pthread_mutex_unlock(&g_efd_m);
     return r;
 }
+// nn::socket::Ioctl. Horizon's requests are FreeBSD's: FIONBIO sets non-blocking from a 4-byte argument, FIONREAD reports what is
+// readable. sm35recomp implements exactly these two (bsd_host.c); nothing here handled Ioctl at all, and Pia makes its UDP socket
+// non-blocking this way rather than with Fcntl, so its NAT check got no usable socket. Any other request succeeds and changes nothing
+enum { SK_FIONBIO = 0x8004667e, SK_FIONREAD = 0x4004667f };
+static int on_ioctl(int fd, uint32_t req, void *arg) {
+    int h = on_host(fd, NULL, NULL, NULL, NULL);
+    if (h < 0) return -1;
+    if (req == SK_FIONBIO) {
+        int v = arg ? *(const int *)arg : 0;
+        pthread_mutex_lock(&g_efd_m);
+        if (sk_used(fd)) g_efd[fd].nonblock = v != 0;
+        pthread_mutex_unlock(&g_efd_m);
+        BTRACE(fd, "socket %d: ioctl FIONBIO %d", fd, v != 0);
+        return 0;
+    }
+    if (req == SK_FIONREAD) {
+        int avail = 0;
+        ioctl(h, FIONREAD, &avail);
+        if (arg) memcpy(arg, &avail, sizeof avail);
+        BTRACE(fd, "socket %d: ioctl FIONREAD -> %d", fd, avail);
+        return 0;
+    }
+    BTRACE(fd, "socket %d: ioctl %#x: nothing done, reported as done", fd, req);
+    return 0;
+}
 static int on_shutdown(int fd, int how) { int h = on_host(fd, NULL, NULL, NULL, NULL); return h < 0 ? -1 : shutdown(h, how) && errno != ENOTCONN ? on_err(errno) : 0; }
 // Poll over sockets and event descriptors alike (each event descriptor through its pipe)
 static int on_poll(sk_pollfd *p, uint64_t n, int ms) {
@@ -810,6 +836,15 @@ SSF("_ZN2nn3ssl10Connection9SetOptionENS1_10OptionTypeEb", h_ssl_CnSetOpt, void
     on_ssl *c = ssl_of(self); if (!c) return RES_FAIL; if (opt == 0) c->keep_socket = on & 1; return RES_OK;
 }
 SSF("_ZN2nn3ssl10Connection19GetSocketDescriptorEPi", h_ssl_CnGetSock, void *self, int *s) { on_ssl *c = ssl_of(self); if (!c) return RES_FAIL; if (s) *s = c->fd; return RES_OK; }
+HLE_FORCE("_ZN2nn6socket5IoctlEiNS0_12IoctlCommandEPvS2_S2_S2_", "socket ioctl (cut: ENETDOWN; online: FIONBIO / FIONREAD)", int, h_sk_Ioctl4, int fd, uint32_t req, void *a1, void *a2, void *a3, void *a4) {
+    (void)a2; (void)a3; (void)a4; if (dm_net_online()) return on_ioctl(fd, req, a1); return sk_fail();
+}
+HLE_FORCE("_ZN2nn6socket5IoctlEiNS0_12IoctlCommandEPv", "socket ioctl, one argument (cut: ENETDOWN)", int, h_sk_Ioctl1, int fd, uint32_t req, void *a1) {
+    if (dm_net_online()) return on_ioctl(fd, req, a1); return sk_fail();
+}
+HLE_FORCE("nnsocketIoctl", "socket ioctl, C form (cut: ENETDOWN)", int, h_nsk_Ioctl, int fd, uint32_t req, void *a1, void *a2, void *a3, void *a4) {
+    (void)a2; (void)a3; (void)a4; if (dm_net_online()) return on_ioctl(fd, req, a1); return sk_fail();
+}
 HLE_FORCE("_ZN2nn3ssl10Connection7PendingEv", "ssl service (cut): nothing pending", int, h_ssl_CnPending, void *self) { (void)self; return 0; }
 // C interface: all return nnResult
 #define SSC(m, cname) HLE_FORCE(m, "ssl service (cut): fails", Result, cname, void) { return RES_FAIL; }
