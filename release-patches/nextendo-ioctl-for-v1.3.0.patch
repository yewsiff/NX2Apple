     on_ssl *c = ssl_of(self); if (!c) return RES_FAIL; if (opt == 0) c->keep_socket = on & 1; return RES_OK;
 }
 SSF("_ZN2nn3ssl10Connection19GetSocketDescriptorEPi", h_ssl_CnGetSock, void *self, int *s) { on_ssl *c = ssl_of(self); if (!c) return RES_FAIL; if (s) *s = c->fd; return RES_OK; }
+HLE_FORCE("_ZN2nn6socket5IoctlEiNS0_12IoctlCommandEPvS2_S2_S2_", "socket ioctl (cut: ENETDOWN; online: FIONBIO / FIONREAD)", int, h_sk_Ioctl4, int fd, uint32_t req, void *a1, void *a2, void *a3, void *a4) {
