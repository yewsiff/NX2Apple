+    pthread_mutex_unlock(&g_efd_m);
+    return 0;
+}
+static int on_listen(int fd, int backlog) { int h = on_host(fd, NULL, NULL, NULL, NULL); return h < 0 ? -1 : listen(h, backlog) ? on_err(errno) : 0; }
