+#include "net_online.h"
+
+#define NX_KC_SERVICE @"nx2apple.nextendo"
+#define NX_SCOPE @"identity game.matchmaking"
+#define NX_SIGNIN_TIMEOUT_S 300
+#define NX_NEX_MIN_LEFT_S 3600     // fetch the game token again when less than this is left
+#define NX_ACCESS_MIN_LEFT_S 60
+#define NX_HTTP_TIMEOUT_S 15
+
+// ---------- switches ----------
+typedef struct { const char *id, *host, *version; } nx_game;
+// The games this host takes online: title ID, the NEX game server's name (g<game server ID>-lp1.s.n.srv.nintendo.net), the version the ID token names
+static const nx_game k_games[] = {
+    {"01006A800016E000", "g23380901-lp1.s.n.srv.nintendo.net", "13.0.5"},   // Super Smash Bros. Ultimate 13.0.5
+    {"0100152000022000", "g2b309e01-lp1.s.n.srv.nintendo.net", "4.0.1"},    // Mario Kart 8 Deluxe 4.0.1 (the name its NEX client asks nn::ssl for is the one used; this is the fallback)
+};
+static struct {
+    int online, log;
+    const nx_game *game;
+    char client_id[128], api[256];
+    int redirect_port;
+    uint32_t server, nat;          // host order
+    uint16_t server_port;
+    uint8_t pin[NX_PINS][32];
+    int npin;
+} C;
+static pthread_once_t g_cfg_once = PTHREAD_ONCE_INIT;
+
+static int parse_ip(const char *s, uint32_t *ip) {
+    struct in_addr a;
+    if (!s || inet_pton(AF_INET, s, &a) != 1) return 0;
+    *ip = ntohl(a.s_addr); return 1;
+}
+static int hexval(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
+// DM_NEXTENDO_PIN holds one pin or several, separated by commas: the game server and the other backends the SNI router fronts (the account API
+// is one of them) need not share a key. A pin is 64 hex digits
+static int parse_one_pin(const char *s, uint8_t out[32]);
+static int parse_pins(const char *s) {
+    C.npin = 0;
+    for (const char *p = s; p && *p && C.npin < NX_PINS;) {
+        while (*p == ',' || *p == ' ' || *p == '\t') p++;
+        if (!*p) break;   // a trailing comma or space ends the list rather than failing it
+        size_t n = strcspn(p, ",");
+        while (n && (p[n - 1] == ' ' || p[n - 1] == '\t')) n--;
+        if (n != 64 || !parse_one_pin(p, C.pin[C.npin])) return 0;
+        C.npin++; p += n;
+    }
+    return C.npin > 0;
+}
+static int parse_one_pin(const char *s, uint8_t out[32]) {
+    if (!s) return 0;
+    for (int i = 0; i < 32; i++) {
+        int h = hexval(s[2 * i]), l = hexval(s[2 * i + 1]);
+        if (h < 0 || l < 0) return 0;
+        out[i] = (uint8_t)(h << 4 | l);
+    }
+    return 1;
+}
+static const char *env(const char *k, const char *def) { const char *v = getenv(k); return v && *v ? v : def; }
+
+static void cfg_init(void) {
+    C.log = atoi(env("DM_NEXTENDO_LOG", "0")) != 0;
+    const char *id = dm_profile()->id;
+    for (size_t i = 0; i < sizeof k_games / sizeof *k_games; i++) if (!strcasecmp(id, k_games[i].id)) C.game = &k_games[i];
+    int asked = atoi(env("DM_NEXTENDO", "0")) != 0;
+    snprintf(C.client_id, sizeof C.client_id, "%s", env("DM_NEXTENDO_CLIENT_ID", NX_CLIENT_ID_DEFAULT));
+    snprintf(C.api, sizeof C.api, "%s", env("DM_NEXTENDO_API", "https://nextendo.network"));
+    size_t al = strlen(C.api);
+    while (al && C.api[al - 1] == '/') C.api[--al] = 0;
+    C.redirect_port = atoi(env("DM_NEXTENDO_REDIRECT_PORT", "47823"));
+    if (C.redirect_port <= 0 || C.redirect_port > 65535) C.redirect_port = 47823;
+    char srv[64];
+    snprintf(srv, sizeof srv, "%s", env("DM_NEXTENDO_SERVER", NX_SERVER_DEFAULT));
+    char *colon = strchr(srv, ':');
+    C.server_port = 443;
+    if (colon) { *colon = 0; int p = atoi(colon + 1); if (p > 0 && p < 65536) C.server_port = (uint16_t)p; }
+    int ok = parse_ip(srv, &C.server) && parse_ip(env("DM_NEXTENDO_NAT", NX_NAT_DEFAULT), &C.nat) && parse_pins(env("DM_NEXTENDO_PIN", NX_PIN_DEFAULT));
+    if (!asked) return;
+    if (!C.game) { LOG("[nextendo] DM_NEXTENDO=1, but this game (%s) is not one the host takes online: it stays offline", id); return; }
+    if (!ok) { LOG("[nextendo] DM_NEXTENDO_SERVER, DM_NEXTENDO_NAT or DM_NEXTENDO_PIN is not valid: offline"); return; }
+    if (!strncmp(C.api, "http://", 7)) {   // only a local test server may go without TLS
+        uint32_t ip; char h[64]; snprintf(h, sizeof h, "%s", C.api + 7);
+        char *e = strpbrk(h, ":/"); if (e) *e = 0;
+        if (!parse_ip(h, &ip) || (ip >> 24) != 127) { LOG("[nextendo] DM_NEXTENDO_API must be https (or a loopback http test server): offline"); return; }
+    }
+    C.online = 1;
+    LOG("[nextendo] online through Nextendo Network: account API %s, game server %s:%u (%s)%s", C.api, srv, C.server_port, C.game->host,
+        C.client_id[0] ? "" : "; no client ID yet (DM_NEXTENDO_CLIENT_ID): sign-in will fail");
+}
+int dm_net_online(void) { pthread_once(&g_cfg_once, cfg_init); return C.online; }
+int nx_log_on(void) { pthread_once(&g_cfg_once, cfg_init); return C.log; }
+const char *nx_game_host(void) { pthread_once(&g_cfg_once, cfg_init); return C.game ? C.game->host : ""; }
+const char *nx_game_version(void) { pthread_once(&g_cfg_once, cfg_init); return C.game ? C.game->version : ""; }
+
+// ---------- names ----------
+int nx_resolve(const char *name, uint32_t *ip) {
+    if (!name) return 0;
+    char n[256]; size_t len = 0;
+    for (const char *p = name; *p && len < sizeof n - 4; p++) {
+        if (*p == '%') { memcpy(n + len, "lp1", 3); len += 3; }   // nsd's environment, which the game leaves in some names ("nncs2-%.n.n.srv.nintendo.net")
+        else n[len++] = (char)tolower((unsigned char)*p);
+    }
+    n[len] = 0;
+    while (len && n[len - 1] == '.') n[--len] = 0;
+    if (parse_ip(n, ip)) return 1;
+    if (!dm_net_online()) return 0;
+    if (!strcmp(n, "localhost")) { *ip = 0x7f000001; return 1; }
+    // Nintendo's names, every domain of theirs Nextendo's own Ryujinx build sends to its servers (DnsMitmResolver.cs: nintendo.net, .com, .co.jp, nintendowifi.net)
+    static const char *const theirs[] = {".nintendo.net", ".nintendo.com", ".nintendowifi.net", ".nintendo.co.jp"};
+    int ours = 0;
+    for (size_t i = 0; i < sizeof theirs / sizeof *theirs && !ours; i++) { size_t sl = strlen(theirs[i]); ours = len > sl && !strcmp(n + len - sl, theirs[i]); }
+    if (ours) {
+        *ip = !strncmp(n, "nncs2", 5) ? C.nat : C.server;
+        NXLOG("name %s -> %s", n, *ip == C.nat ? "the NAT check" : "the game server");
+        return 1;
+    }
+    char shown[64];   // the name as given, non-printable bytes escaped: a garbled name is a finding of its own
+    size_t si = 0;
+    for (const char *p2 = name; *p2 && si < sizeof shown - 5; p2++)
+        si += (size_t)(*p2 >= 32 && *p2 < 127 ? (shown[si] = *p2, 1) : snprintf(shown + si, 5, "\\x%02x", (unsigned char)*p2));
+    shown[si] = 0;
+    size_t rawn = strlen(name);
+    if (rawn >= 4 && rawn <= 5) {   // a binary address passed where a hostname was expected shows up as a short unprintable "name"
+        const unsigned char *b = (const unsigned char *)name;
+        NXLOG("name (%zu bytes) %s = octets %u.%u.%u.%u: not resolved (looks like a binary address, not a hostname)", rawn, shown, b[0], b[1], b[2], b[3]);
+    } else NXLOG("name %s (%zu bytes): not resolved (only Nintendo's names are, online)", shown, rawn);
+    return 0;
+}
+int nx_is_server(uint32_t ip) { return dm_net_online() && ip == C.server; }
+int nx_dest_allowed(uint32_t ip, int udp) {
+    if (!dm_net_online()) return 0;
+    if (udp) return 1;
+    return ip == NX_BRIDGE_IP || ip == C.server || ip == C.nat;
+}
+// The device's own address on the network it plays over. The game puts it in the private half of its station URL, and a server that pairs a
+// private candidate with a public one has nothing to bridge without it, so a zero here is a session that cannot be joined
+uint32_t nx_local_ip(void) {
+    // What the default route would use: connect a UDP socket (which sends nothing) and read its name
+    int s = socket(AF_INET, SOCK_DGRAM, 0);
+    uint32_t ip = 0;
+    if (s >= 0) {
+        struct sockaddr_in a = {.sin_len = sizeof a, .sin_family = AF_INET, .sin_port = htons(9), .sin_addr.s_addr = htonl(C.server ? C.server : 0x08080808)};
+        if (!connect(s, (struct sockaddr *)&a, sizeof a)) {
+            struct sockaddr_in me; socklen_t ml = sizeof me;
+            if (!getsockname(s, (struct sockaddr *)&me, &ml)) ip = ntohl(me.sin_addr.s_addr);
+        }
+        close(s);
+    }
+    if (ip) return ip;
+    // No route yet (the interface still coming up, or the address asked for before the network is ready): the first address of an interface that
+    // is up and is not the loopback, Wi-Fi (en*) ahead of the rest
+    struct ifaddrs *list = NULL;
+    if (getifaddrs(&list)) return 0;
+    uint32_t best = 0, any = 0;
+    for (struct ifaddrs *f = list; f; f = f->ifa_next) {
+        if (!f->ifa_addr || f->ifa_addr->sa_family != AF_INET) continue;
+        if (!(f->ifa_flags & IFF_UP) || (f->ifa_flags & IFF_LOOPBACK)) continue;
+        uint32_t v = ntohl(((struct sockaddr_in *)f->ifa_addr)->sin_addr.s_addr);
+        if (!v || (v >> 24) == 127) continue;
+        if (!any) any = v;
+        if (!best && f->ifa_name && f->ifa_name[0] == 'e' && f->ifa_name[1] == 'n') best = v;
+    }
+    freeifaddrs(list);
+    ip = best ? best : any;
+    if (ip) NXLOG("the default route gave no address of ours; an interface that is up has %u.%u.%u.%u", ip >> 24, ip >> 16 & 255, ip >> 8 & 255, ip & 255);
+    return ip;
+}
+
+// ---------- Keychain ----------
+static NSMutableDictionary *kc_query(NSString *account) {
+    return [@{(__bridge id)kSecClass: (__bridge id)kSecClassGenericPassword, (__bridge id)kSecAttrService: NX_KC_SERVICE,
+              (__bridge id)kSecAttrAccount: account} mutableCopy];
+}
+static NSData *kc_get(NSString *account) {
+    NSMutableDictionary *q = kc_query(account);
+    q[(__bridge id)kSecReturnData] = @YES; q[(__bridge id)kSecMatchLimit] = (__bridge id)kSecMatchLimitOne;
+    CFTypeRef out = NULL;
+    if (SecItemCopyMatching((__bridge CFDictionaryRef)q, &out) != errSecSuccess || !out) return nil;
+    return (__bridge_transfer NSData *)out;
+}
+static int kc_set(NSString *account, NSData *value) {
+    NSMutableDictionary *q = kc_query(account);
+    OSStatus st = SecItemUpdate((__bridge CFDictionaryRef)q, (__bridge CFDictionaryRef)@{(__bridge id)kSecValueData: value});
+    if (st == errSecItemNotFound) {
+        q[(__bridge id)kSecValueData] = value;
+        q[(__bridge id)kSecAttrAccessible] = (__bridge id)kSecAttrAccessibleAfterFirstUnlock;
+        st = SecItemAdd((__bridge CFDictionaryRef)q, NULL);
+    }
+    if (st != errSecSuccess) LOG("[nextendo] could not keep %s in the Keychain (OSStatus %d)", account.UTF8String, (int)st);
+    return st == errSecSuccess;
+}
+static void kc_del(NSString *account) { SecItemDelete((__bridge CFDictionaryRef)kc_query(account)); }
+static NSString *kc_str(NSString *account) { NSData *d = kc_get(account); return d ? [[NSString alloc] initWithData:d encoding:NSUTF8StringEncoding] : nil; }
+static int kc_set_str(NSString *account, NSString *s) { return kc_set(account, [s dataUsingEncoding:NSUTF8StringEncoding]); }
+
+// ---------- small helpers ----------
+static NSString *b64url(NSData *d) {
+    NSString *s = [d base64EncodedStringWithOptions:0];
+    s = [s stringByReplacingOccurrencesOfString:@"+" withString:@"-"];
+    s = [s stringByReplacingOccurrencesOfString:@"/" withString:@"_"];
+    return [s stringByReplacingOccurrencesOfString:@"=" withString:@""];
+}
+static NSData *random_data(size_t n) {
+    NSMutableData *d = [NSMutableData dataWithLength:n];
+    if (SecRandomCopyBytes(kSecRandomDefault, n, d.mutableBytes) != errSecSuccess) arc4random_buf(d.mutableBytes, n);
+    return d;
+}
+static NSData *sha256(NSData *d) {
+    NSMutableData *h = [NSMutableData dataWithLength:CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256(d.bytes, (CC_LONG)d.length, h.mutableBytes);
+    return h;
+}
+static NSString *form_escape(NSString *s) {
+    NSMutableCharacterSet *ok = [NSMutableCharacterSet alphanumericCharacterSet];
+    [ok addCharactersInString:@"-._~"];
+    return [s stringByAddingPercentEncodingWithAllowedCharacters:ok];
+}
+// A caller that waits on the host (the network, the sign-in sheet) gives up its guest core meanwhile (hle_thread.c)
+static long wait_sem(dispatch_semaphore_t s, double seconds) {
+    dm_thread_native_wait(1);
+    long r = dispatch_semaphore_wait(s, dispatch_time(DISPATCH_TIME_NOW, (int64_t)(seconds * NSEC_PER_SEC)));
+    dm_thread_native_wait(0);
+    return r;
+}
+
+// Runs work on a host thread and waits for it: a guest thread's stack can be as small as 8 KB, too small for Foundation, Security and the
+// network stack, and dispatch_sync may run its block on the calling thread, so the work goes to a global queue and the caller waits for it
+static void on_host_thread(void (^work)(void)) {
+    if ([NSThread isMainThread]) { work(); return; }
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{ @autoreleasepool { work(); } dispatch_semaphore_signal(done); });
+    dm_thread_native_wait(1);
+    dispatch_semaphore_wait(done, DISPATCH_TIME_FOREVER);
+    dm_thread_native_wait(0);
+}
+
+// One HTTP request, waited for. Returns the status (0: no answer) and the body as JSON in *json when it is an object
+static int http(NSString *method, NSString *url, NSString *bearer, NSString *form, NSDictionary **json) {
+    NSMutableURLRequest *rq = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:url] cachePolicy:NSURLRequestReloadIgnoringLocalCacheData
+                                                  timeoutInterval:NX_HTTP_TIMEOUT_S];
+    rq.HTTPMethod = method;
+    [rq setValue:@"application/json" forHTTPHeaderField:@"Accept"];
+    if (C.client_id[0]) [rq setValue:@(C.client_id) forHTTPHeaderField:@"X-Nextendo-Client-Id"];
+    if (bearer) [rq setValue:[@"Bearer " stringByAppendingString:bearer] forHTTPHeaderField:@"Authorization"];
+    if (form) {
+        [rq setValue:@"application/x-www-form-urlencoded" forHTTPHeaderField:@"Content-Type"];
+        rq.HTTPBody = [form dataUsingEncoding:NSUTF8StringEncoding];
+    }
+    __block int status = 0; __block NSData *body = nil;
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    NSURLSessionDataTask *t = [NSURLSession.sharedSession dataTaskWithRequest:rq completionHandler:^(NSData *d, NSURLResponse *r, NSError *e) {
+        if (!e && [r isKindOfClass:NSHTTPURLResponse.class]) { status = (int)((NSHTTPURLResponse *)r).statusCode; body = d; }
+        else if (e) LOG("[nextendo] %s %s: %s", method.UTF8String, rq.URL.path.UTF8String, e.localizedDescription.UTF8String);
+        dispatch_semaphore_signal(done);
+    }];
+    [t resume];
+    if (wait_sem(done, NX_HTTP_TIMEOUT_S + 5)) { [t cancel]; return 0; }
+    if (json) {
+        id j = body.length ? [NSJSONSerialization JSONObjectWithData:body options:0 error:nil] : nil;
+        *json = [j isKindOfClass:NSDictionary.class] ? j : nil;
+    }
+    return status;
+}
+static NSString *jstr(NSDictionary *j, NSString *k) { id v = j[k]; return [v isKindOfClass:NSString.class] ? v : nil; }
+static double jnum(NSDictionary *j, NSString *k, double def) { id v = j[k]; return [v isKindOfClass:NSNumber.class] ? [v doubleValue] : def; }
+
+// ---------- the account ----------
+static pthread_mutex_t g_acc_m = PTHREAD_MUTEX_INITIALIZER;   // one sign-in / refresh / game-token exchange at a time, and the state below
+static struct {
+    int loaded;
+    NSString *refresh, *access, *nex, *username;
+    time_t access_exp, nex_exp;
+    uint64_t pid;
+} A;
+
+static void acc_load(void) {   // with g_acc_m held
+    if (A.loaded) return;
+    A.loaded = 1;
+    if (atoi(env("DM_NEXTENDO_SIGNOUT", "0"))) { kc_del(@"refresh_token"); kc_del(@"username"); LOG("[nextendo] signed out (DM_NEXTENDO_SIGNOUT)"); }
+    A.refresh = kc_str(@"refresh_token");
+    A.username = kc_str(@"username");
+}
+static void acc_forget(const char *why) {   // with g_acc_m held: the stored account no longer works
+    LOG("[nextendo] the stored account no longer signs in (%s): sign in again", why);
+    kc_del(@"refresh_token"); A.refresh = nil; A.access = nil; A.nex = nil; A.pid = 0;
+}
+// Keep what /oauth/token answered. 1 when it carried an access token
+static int take_tokens(NSDictionary *j) {
+    NSString *at = jstr(j, @"access_token"), *rt = jstr(j, @"refresh_token");
+    if (!at.length) return 0;
+    A.access = at;
+    A.access_exp = time(NULL) + (time_t)jnum(j, @"expires_in", 3600);
+    if (rt.length && ![rt isEqualToString:A.refresh]) { A.refresh = rt; kc_set_str(@"refresh_token", rt); }
+    return 1;
+}
+static int token_request(NSString *form, NSDictionary **j) {   // the token endpoint: /oauth/token, else /api/oauth/token (a 404 there)
+    int st = http(@"POST", [@(C.api) stringByAppendingString:@"/oauth/token"], nil, form, j);
+    if (st == 404) st = http(@"POST", [@(C.api) stringByAppendingString:@"/api/oauth/token"], nil, form, j);
+    return st;
+}
