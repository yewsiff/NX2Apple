+#if TARGET_OS_IPHONE
+@interface NxSheetAnchor : NSObject <ASWebAuthenticationPresentationContextProviding>
+@end
+@implementation NxSheetAnchor
+- (ASPresentationAnchor)presentationAnchorForWebAuthenticationSession:(ASWebAuthenticationSession *)session {
+    (void)session;
+    for (UIScene *s in UIApplication.sharedApplication.connectedScenes)
+        if ([s isKindOfClass:UIWindowScene.class])
+            for (UIWindow *w in ((UIWindowScene *)s).windows) if (w.isKeyWindow) return w;
+    for (UIScene *s in UIApplication.sharedApplication.connectedScenes)
+        if ([s isKindOfClass:UIWindowScene.class] && ((UIWindowScene *)s).windows.count) return ((UIWindowScene *)s).windows.firstObject;
+    return [[UIWindow alloc] init];
+}
