+// The loopback listener: the browser's redirect to http://127.0.0.1:<port>/callback?code=..&state=.. comes here
+static NSString *g_wait_state; static NSString *g_got_code; static NSString *g_got_error;
+static dispatch_semaphore_t g_signin_done;
+static atomic_int g_listen_fd = -1;
+
+static NSString *query_value(NSString *query, NSString *key) {
+    for (NSString *kv in [query componentsSeparatedByString:@"&"]) {
+        NSRange eq = [kv rangeOfString:@"="];
+        if (eq.location == NSNotFound) continue;
+        if ([[kv substringToIndex:eq.location] isEqualToString:key])
+            return [[[kv substringFromIndex:eq.location + 1] stringByReplacingOccurrencesOfString:@"+" withString:@" "] stringByRemovingPercentEncoding];
+    }
+    return nil;
+}
+static void listener_thread(int ls) {
+    time_t until = time(NULL) + NX_SIGNIN_TIMEOUT_S;
+    while (time(NULL) < until && atomic_load(&g_listen_fd) == ls) {
+        struct timeval tv = {1, 0};
+        fd_set r; FD_ZERO(&r); FD_SET(ls, &r);
+        if (select(ls + 1, &r, NULL, NULL, &tv) <= 0) continue;
+        int c = accept(ls, NULL, NULL);
+        if (c < 0) continue;
+        struct timeval rt = {5, 0}; setsockopt(c, SOL_SOCKET, SO_RCVTIMEO, &rt, sizeof rt);
+        char req[4096]; ssize_t n = 0, k;
+        while (n < (ssize_t)sizeof req - 1 && (k = recv(c, req + n, sizeof req - 1 - (size_t)n, 0)) > 0) { n += k; req[n] = 0; if (strstr(req, "\r\n\r\n")) break; }
+        req[n > 0 ? n : 0] = 0;
+        NSString *line = [[NSString stringWithUTF8String:req] componentsSeparatedByString:@"\r\n"].firstObject ?: @"";
+        NSArray *parts = [line componentsSeparatedByString:@" "];
+        NSString *target = parts.count >= 2 ? parts[1] : @"";
+        NSRange q = [target rangeOfString:@"?"];
+        int ours = [target hasPrefix:@"/callback"] && q.location != NSNotFound;
+        NSString *query = ours ? [target substringFromIndex:q.location + 1] : @"";
+        NSString *code = query_value(query, @"code"), *state = query_value(query, @"state"), *err = query_value(query, @"error");
+        int good = ours && state && [state isEqualToString:g_wait_state] && (code.length || err.length);
+        const char *page = good && code.length ? "Signed in to Nextendo. You can go back to the game." : good ? "Nextendo sign-in was not completed. You can go back to the game." : "Not found.";
+        char resp[512];
+        int rl = snprintf(resp, sizeof resp, "HTTP/1.1 %s\r\nContent-Type: text/html; charset=utf-8\r\nConnection: close\r\nCache-Control: no-store\r\n\r\n"
+                          "<!doctype html><meta charset=utf-8><title>Nextendo</title><body style=\"font-family:-apple-system,sans-serif;padding:2em\">%s</body>",
+                          good ? "200 OK" : "404 Not Found", page);
+        send(c, resp, (size_t)rl, 0);
+        close(c);
+        if (!good) continue;
+        g_got_code = code; g_got_error = code.length ? nil : err;
+        dispatch_semaphore_signal(g_signin_done);
+        break;
+    }
+    int expect = ls;
+    if (atomic_compare_exchange_strong(&g_listen_fd, &expect, -1)) close(ls);
+}
