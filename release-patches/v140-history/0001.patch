+// Shows the sign-in page and waits for the redirect. With g_acc_m held. 1 when signed in
+static int sign_in(void) {
+    if (!C.client_id[0]) { LOG("[nextendo] no client ID: register an application at nextendo.network/developers and set DM_NEXTENDO_CLIENT_ID (docs/nextendo.md)"); return 0; }
+    int ls = socket(AF_INET, SOCK_STREAM, 0);
+    int one = 1; setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+    struct sockaddr_in a = {.sin_len = sizeof a, .sin_family = AF_INET, .sin_port = htons((uint16_t)C.redirect_port), .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};
+    if (ls < 0 || bind(ls, (struct sockaddr *)&a, sizeof a) || listen(ls, 4)) {
+        LOG("[nextendo] cannot listen on 127.0.0.1:%d for the sign-in redirect (%s)", C.redirect_port, strerror(errno));
+        if (ls >= 0) close(ls);
+        return 0;
+    }
+    NSString *verifier = b64url(random_data(32)), *state = b64url(random_data(16));
+    NSString *challenge = b64url(sha256([verifier dataUsingEncoding:NSUTF8StringEncoding]));
+    NSString *redirect = [NSString stringWithFormat:@"http://127.0.0.1:%d/callback", C.redirect_port];
+    NSString *url = [NSString stringWithFormat:@"%s/oauth/authorize?response_type=code&client_id=%@&redirect_uri=%@&scope=%@&state=%@&code_challenge=%@&code_challenge_method=S256",
+                     C.api, form_escape(@(C.client_id)), form_escape(redirect), form_escape(NX_SCOPE), state, challenge];
+    g_wait_state = state; g_got_code = nil; g_got_error = nil;
+    g_signin_done = dispatch_semaphore_create(0);
+    int old = atomic_exchange(&g_listen_fd, ls);
+    if (old >= 0) close(old);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{ listener_thread(ls); });
+    LOG("[nextendo] sign in to Nextendo in the browser that opens");
+    NSURL *u = [NSURL URLWithString:url];
+    dispatch_async(dispatch_get_main_queue(), ^{
+#if TARGET_OS_IPHONE
+        // The sheet's own callback scheme is never used: the redirect goes to the loopback listener, which then closes the sheet
+        g_anchor = [NxSheetAnchor new];
+        g_sheet = [[ASWebAuthenticationSession alloc] initWithURL:u callbackURLScheme:@"nx2apple-nextendo" completionHandler:^(NSURL *cb, NSError *e) {
+            (void)cb;
+            if (e && !g_got_code) { g_got_error = @"cancelled"; dispatch_semaphore_signal(g_signin_done); }
+        }];
+        g_sheet.presentationContextProvider = g_anchor;
+        if (![g_sheet start]) { g_got_error = @"the sign-in sheet did not open"; dispatch_semaphore_signal(g_signin_done); }
+#else
+        if (![NSWorkspace.sharedWorkspace openURL:u]) { g_got_error = @"no browser opened"; dispatch_semaphore_signal(g_signin_done); }
+#endif
+    });
+    int timed_out = wait_sem(g_signin_done, NX_SIGNIN_TIMEOUT_S) != 0;
+    int cur = ls;
+    if (atomic_compare_exchange_strong(&g_listen_fd, &cur, -1)) close(ls);
+#if TARGET_OS_IPHONE
+    dispatch_async(dispatch_get_main_queue(), ^{ [g_sheet cancel]; g_sheet = nil; g_anchor = nil; });
+#endif
+    NSString *code = g_got_code;
+    g_got_code = nil;
+    if (!code.length) { LOG("[nextendo] sign-in not completed (%s)", timed_out ? "timed out" : g_got_error.UTF8String ?: "no code"); return 0; }
+    NSString *form = [NSString stringWithFormat:@"grant_type=authorization_code&client_id=%@&code=%@&redirect_uri=%@&code_verifier=%@",
+                      form_escape(@(C.client_id)), form_escape(code), form_escape(redirect), form_escape(verifier)];
+    NSDictionary *j = nil;
+    int st = token_request(form, &j);
+    if (st != 200 || !take_tokens(j) || !A.refresh.length) { LOG("[nextendo] sign-in: the token exchange failed (HTTP %d%s%s)", st, jstr(j, @"error") ? ", " : "", jstr(j, @"error").UTF8String ?: ""); return 0; }
+    LOG("[nextendo] signed in");
+    return 1;
+}
+static int ensure_access(void) {   // with g_acc_m held
+    if (A.access.length && A.access_exp - time(NULL) > NX_ACCESS_MIN_LEFT_S) return 1;
+    if (!A.refresh.length) return 0;
+    NSDictionary *j = nil;
+    int st = token_request([NSString stringWithFormat:@"grant_type=refresh_token&refresh_token=%@&client_id=%@", form_escape(A.refresh), form_escape(@(C.client_id))], &j);
+    if (st == 200 && take_tokens(j)) return 1;
+    if (st == 400 || st == 401) acc_forget(jstr(j, @"error").UTF8String ?: "refused");
+    else LOG("[nextendo] could not refresh the sign-in (HTTP %d)", st);
+    return 0;
+}
+static int fetch_nex(void) {   // with g_acc_m held
+    NSDictionary *j = nil;
+    int st = http(@"GET", [@(C.api) stringByAppendingString:@"/api/nex-token"], A.access, nil, &j);
+    NSString *nt = jstr(j, @"nex_token"), *un = jstr(j, @"username");
+    double pid = jnum(j, @"pid", 0);
+    if (st == 401) { A.access = nil; return 0; }
+    if (st != 200 || !nt.length || pid <= 0 || nt.length > 1024) { LOG("[nextendo] no game token (HTTP %d)", st); return 0; }
+    for (NSUInteger i = 0; i < nt.length; i++) { unichar ch = [nt characterAtIndex:i]; if (ch <= ' ' || ch == '"' || ch == '\\' || ch > 126) { LOG("[nextendo] the game token is not a token"); return 0; } }
+    A.nex = nt; A.pid = (uint64_t)pid;
+    A.nex_exp = time(NULL) + (time_t)jnum(j, @"expires_in", 3600);
+    if (un.length && ![un isEqualToString:A.username]) { A.username = un; kc_set_str(@"username", un); }
+    LOG("[nextendo] game token ready (%s)", A.username.UTF8String ?: "signed in");
+    return 1;
+}
+static int account_ready(void) {
+    pthread_mutex_lock(&g_acc_m);
+    acc_load();
+    int ok = A.nex.length && A.nex_exp - time(NULL) > NX_NEX_MIN_LEFT_S;
+    for (int attempt = 0; !ok && attempt < 2; attempt++) {
+        if (!A.refresh.length && !sign_in()) break;
+        if (!ensure_access()) continue;   // (a refused refresh token forgot the account: the second attempt signs in)
+        ok = fetch_nex();
+    }
+    pthread_mutex_unlock(&g_acc_m);
+    return ok;
+}
+int nx_account_ready(int timeout_ms) {
+    (void)timeout_ms;   // each step has its own bound: the sign-in 5 minutes, each request NX_HTTP_TIMEOUT_S
+    if (!dm_net_online()) return 0;
+    __block int ok = 0;
+    on_host_thread(^{ ok = account_ready(); });
+    return ok;
+}
+static int username_(char *out, size_t cap);
+uint64_t nx_pid(void) { pthread_mutex_lock(&g_acc_m); uint64_t p = A.pid; pthread_mutex_unlock(&g_acc_m); return p; }
+int nx_username(char *out, size_t cap) {
+    __block int r = 0;
+    on_host_thread(^{ r = username_(out, cap); });
+    return r;
+}
+static int username_(char *out, size_t cap) {
+    pthread_mutex_lock(&g_acc_m);
+    acc_load();
+    int ok = A.username.length > 0;
+    if (ok) snprintf(out, cap, "%s", A.username.UTF8String);
+    pthread_mutex_unlock(&g_acc_m);
+    return ok;
+}
