+@interface NxBridge : NSObject
+@end
+@implementation NxBridge {
+@public
+    int fd;
+    dispatch_queue_t q;
+    dispatch_source_t rd;
+    nw_connection_t conn;
+    NSMutableData *pending;   // what the game sent before the connection was ready, or the first request while its header is incomplete
+    NSString *sni;            // the server name asked for, and the first request's Host when the header is rewritten
+    int ready, closed, header_done;
+    // DM_NEXTENDO_LOG: what crosses the bridge, without the payloads (the login carries the account's token): the HTTP heads, then each
+    // WebSocket frame's opcode and length per direction, a close frame's code and reason, and the byte counts at the end
+    uint64_t sent, got;
+    NSMutableData *rhead;     // the server's HTTP head until its blank line
+    int rhead_done, nframes[2];
+    struct { int have; uint8_t h[14]; uint64_t skip, len; int op, masked; uint8_t mask[4]; unsigned pos, capn; uint8_t cap[640]; } ws[2];   // 0: game → server, 1: server → game
+    int nnex, split[2];       // NEX calls logged so far; a split NEX message is passing in this direction
+    NSMutableData *cbody[2];  // a close frame's body while it passes
+    NSString *wsproto;        // the WebSocket subprotocol the game's request asks for ("NEX"); the server's answer must name it
+    NSString *wskey;          // the request's Sec-WebSocket-Key: the answer's Sec-WebSocket-Accept is checked against it
+}
+static NSString *head_value(NSData *head, NSString *name) {   // a header's value (name in lower case), nil when absent
+    NSString *s = [[NSString alloc] initWithData:head encoding:NSISOLatin1StringEncoding];
+    NSString *want = [name stringByAppendingString:@":"];
+    for (NSString *ln in [s componentsSeparatedByString:@"\r\n"])
+        if ([ln.lowercaseString hasPrefix:want])
+            return [[ln substringFromIndex:want.length] stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+    return nil;
+}
+// RFC 6455: base64(SHA-1(key + the fixed GUID)), what a client checks the server's Sec-WebSocket-Accept against
+static NSString *ws_accept_for(NSString *key) {
+    NSData *in = [[key stringByAppendingString:@"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"] dataUsingEncoding:NSUTF8StringEncoding];
+    uint8_t h[CC_SHA1_DIGEST_LENGTH];
+    CC_SHA1(in.bytes, (CC_LONG)in.length, h);
+    return [[NSData dataWithBytes:h length:sizeof h] base64EncodedStringWithOptions:0];
+}
+// The answer's Sec-WebSocket-Accept, checked against the request's key; a wrong one is logged and corrected (the game drops the connection on it)
+static NSData *ws_fix_accept(NSData *head, NSString *key) {
+    NSString *got = head_value(head, @"sec-websocket-accept");
+    if (!key.length || !got) return head;
+    NSString *want = ws_accept_for(key);
+    if ([got isEqualToString:want]) { NXLOG("bridge: the server's Sec-WebSocket-Accept is right for the game's key"); return head; }
+    LOG("[nextendo] bridge: the server's Sec-WebSocket-Accept is wrong for the game's key: corrected");
+    NSString *s = [[NSString alloc] initWithData:head encoding:NSISOLatin1StringEncoding];
+    NSMutableArray *lines = [[s componentsSeparatedByString:@"\r\n"] mutableCopy];
+    for (NSUInteger i = 0; i < lines.count; i++)
+        if ([[lines[i] lowercaseString] hasPrefix:@"sec-websocket-accept:"]) lines[i] = [@"Sec-WebSocket-Accept: " stringByAppendingString:want];
+    return [[lines componentsJoinedByString:@"\r\n"] dataUsingEncoding:NSISOLatin1StringEncoding];
+}
+// The WebSocket subprotocol a request head asks for, nil when none
+static NSString *ws_protocol(NSData *head) {
+    NSString *s = [[NSString alloc] initWithData:head encoding:NSISOLatin1StringEncoding];
+    for (NSString *ln in [s componentsSeparatedByString:@"\r\n"])
+        if ([ln.lowercaseString hasPrefix:@"sec-websocket-protocol:"])
+            return [[ln substringFromIndex:23] stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+    return nil;
+}
+// The server's 101 answer, with the subprotocol the game asked for when the server left it out. RFC 6455 lets a server pick none, but
+// the game's NEX client then drops the connection at once (Nextendo's game server answers without it; WindowSmash's lobby, which the
+// game accepts, names NEX). Any other answer passes unchanged
+static NSData *ws_fix_answer(NSData *head, NSString *proto) {
+    NSString *s = [[NSString alloc] initWithData:head encoding:NSISOLatin1StringEncoding];
+    if (!proto.length || ![s hasPrefix:@"HTTP/1.1 101"] || [s.lowercaseString containsString:@"\r\nsec-websocket-protocol:"]) return head;
+    NSString *fixed = [[s substringToIndex:s.length - 2] stringByAppendingFormat:@"Sec-WebSocket-Protocol: %@\r\n\r\n", proto];
+    LOG("[nextendo] bridge: the server's answer names no WebSocket subprotocol: %s added, as the game asked", proto.UTF8String);
+    return [fixed dataUsingEncoding:NSISOLatin1StringEncoding];
+}
+// DM_NEXTENDO_LOG: which NEX calls cross the bridge, from the first bytes of each binary frame. A frame is a PRUDP Lite packet (as Nextendo's server
+// writes it, nextendo-nex prudp_lite.go: 0x80, the options' length, the payload's (u16), the stream types, two ports, the fragment number, type | flags << 4
+// (u16), the sequence number (u16), the options, the payload), and a DATA packet's payload an RMC message (rmc.go: its length (u32), the protocol, with
+// bit 7 set on a call; then a call's id and method, or an answer's success byte and its id and method, or its result code and id). Lite's payload is in
+// the clear (TLS carries it). Only numbers are logged: the protocol, the method, the call's id, a failed call's result code, and of two NAT traversal calls
+// the figures the whole question is about (what the game reports of its NAT, and whether a hole punch worked). No station URL, token, name or id of a
+// player is read. Keep-alives and bare acknowledgements are left out
+static const char *nex_protocol(unsigned p) {
+    switch (p) {
+    case 0x03: return "NAT traversal"; case 0x0a: return "ticket granting"; case 0x0b: return "secure connection"; case 0x0e: return "notifications";
+    case 0x15: return "match making"; case 0x1b: return "message delivery"; case 0x32: return "match making (ext)"; case 0x6d: return "matchmake extension";
+    case 0x6e: return "utility"; case 0x70: return "ranking"; case 0x73: return "data store"; case 0x78: return "matchmake referee";
+    default: return "protocol";
+    }
+}
+static uint32_t le32(const uint8_t *b) { return (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24; }
+// The station URLs in a message, logged as they stand. They are plain strings in the payload ("address=...;port=...;type=...;Pa=..."), and they
+// are the whole of what a server has to work with when it pairs a private candidate with a public one for a hole punch: which addresses and
+// ports the game registers for itself, and which ones it is given for the other player. Nothing else in these messages is read
+static int nex_stations(const uint8_t *b, unsigned n, const char *what) {
+    int found = 0;
+    for (unsigned i = 0; i + 8 < n; i++) {
+        if (memcmp(b + i, "address=", 8)) continue;
+        unsigned s0 = i;
+        while (s0 && b[s0 - 1] >= 0x20 && b[s0 - 1] < 0x7f) s0--;   // back to the start of the printable run (the scheme, "prudps:/")
+        unsigned e = i;
+        while (e < n && b[e] >= 0x20 && b[e] < 0x7f) e++;
+        char t[256]; unsigned len = e - s0 < sizeof t - 1 ? e - s0 : (unsigned)sizeof t - 1;
+        memcpy(t, b + s0, len); t[len] = 0;
+        LOG("[nextendo] station URL (%s): %s", what, t);
+        found++;
+        i = e;
+    }
+    // Nothing that looks like one. Either these messages do not carry them in the clear, or they are laid out differently from the assumption
+    // here, and the only way to tell is to see the bytes: the head of the message, printable characters as themselves and the rest as dots
+    if (!found) {
+        char hex[3 * 48 + 1], asc[49];
+        unsigned k = n < 48 ? n : 48;
+        for (unsigned i = 0; i < k; i++) { snprintf(hex + 3 * i, 4, "%02x ", b[i]); asc[i] = b[i] >= 0x20 && b[i] < 0x7f ? (char)b[i] : '.'; }
+        hex[3 * k] = 0; asc[k] = 0;
+        LOG("[nextendo] no station URL in the %s message (%u bytes); its first %u: %s|%s", what, n, k, hex, asc);
+    }
+    return found;
+}
+// 1 when a line was written. b: the first n bytes of the frame's payload (unmasked), total: the payload's whole length. *split: a split message is passing
+// What the auth server reads out of a NEX login, read here the same way, so a log says whether it will find us rather than leaving it to be
+// guessed at. The login carries the account's PID as its username and the BaaS ID token in its extra data; the signed Nextendo token rides in
+// that token's "nnex" claim, and the server validates the claim's HMAC and refuses any PID the claim does not prove (nextendo-nex,
+// authbinding.go NexTokenFromLoginExtraData, and ryujinx-nextendo, ManagerServer::GenerateIdToken). A login with no claim is a login the server
+// cannot tie to an account: it may let the connection stand and still refuse to place us in a match
+static int jwt_byte(uint8_t c) { return c == '.' || c == '-' || c == '_' || (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'); }
+static NSData *jwt_payload(const uint8_t *b, unsigned n) {
+    for (unsigned i = 0; i + 3 <= n; i++) {
+        if (memcmp(b + i, "eyJ", 3)) continue;
+        unsigned j = i;
+        while (j < n && jwt_byte(b[j])) j++;
+        const uint8_t *seg = NULL; unsigned seglen = 0, dots = 0;
+        for (unsigned k = i; k <= j; k++) {
+            if (k == j || b[k] == '.') {
+                if (dots == 1) { seglen = (unsigned)(b + k - seg); break; }
+                dots++; seg = b + k + 1;
+            }
+        }
+        if (!seg || !seglen) continue;
+        NSMutableString *t = [NSMutableString stringWithString:[[NSString alloc] initWithBytes:seg length:seglen encoding:NSASCIIStringEncoding] ?: @""];
+        [t replaceOccurrencesOfString:@"-" withString:@"+" options:0 range:NSMakeRange(0, t.length)];
+        [t replaceOccurrencesOfString:@"_" withString:@"/" options:0 range:NSMakeRange(0, t.length)];
+        while (t.length % 4) [t appendString:@"="];
+        NSData *d = [[NSData alloc] initWithBase64EncodedString:t options:0];
+        if (d.length) return d;
+    }
+    return nil;
+}
+static void nex_login_note(const uint8_t *b, unsigned bl, unsigned method) {
+    char name[48] = "";
+    unsigned len = bl >= 2 ? (b[0] | (unsigned)b[1] << 8) : 0;   // a NEX String: its length, then the bytes with their terminator
+    if (len && 2u + len <= bl) {
+        unsigned k = len && b[2 + len - 1] == 0 ? len - 1 : len;
+        if (k >= sizeof name) k = sizeof name - 1;
+        memcpy(name, b + 2, k); name[k] = 0;
+        for (unsigned i = 0; i < k; i++) if (name[i] < 0x20 || name[i] >= 0x7f) name[i] = '.';
+    }
+    uint64_t pid = nx_pid();
+    char want[24]; snprintf(want, sizeof want, "%llu", (unsigned long long)pid);
+    NSData *payload = jwt_payload(b, bl);
+    const char *claim = payload.length ? strstr([[NSString alloc] initWithData:payload encoding:NSUTF8StringEncoding].UTF8String ?: "", "\"nnex\"") : NULL;
+    LOG("[nextendo] NEX: the login names us %s%s; its ID token %s%s", name[0] ? name : "(no name)",
+        pid && !strcmp(name, want) ? " (our Nextendo PID, as it must be)" : pid ? " -- NOT our Nextendo PID, which the server will refuse" : "",
+        !payload.length ? "is MISSING, so the server cannot tie this login to an account" :
+        claim ? "carries the signed Nextendo token, which is what proves the PID" : "carries NO nnex claim, so the server cannot tie this login to an account",
+        method == 3 ? " (ValidateAndRequestTicket)" : method == 2 ? " (LoginEx)" : " (Login)");
+}
+static int nex_note(const uint8_t *b, unsigned n, uint64_t total, int dir, int *split, int quiet) {
+    const char *who = dir ? "server → game" : "game → server";
+    if (n < 12 || b[0] != 0x80) return 0;
+    unsigned optn = b[1], plen = b[2] | (unsigned)b[3] << 8, frag = b[7], tf = b[8] | (unsigned)b[9] << 8, type = tf & 15, flags = tf >> 4;
+    if (type != 2) {   // 0 SYN, 1 CONNECT, 3 DISCONNECT; 4 PING and Smash's keep-alive 8 are not worth a line
+        if (type == 4 || type == 8 || quiet) return 0;
+        NXLOG("NEX: %s %s%s", who, type == 0 ? "SYN" : type == 1 ? "CONNECT" : type == 3 ? "DISCONNECT" : "packet", flags & 1 ? " (acknowledged)" : "");
+        return 1;
+    }
+    if (!plen || (flags & 0x201)) return 0;                // an acknowledgement (bare, or a list of sequence numbers)
+    if (frag > 1) return 0;                                // a later piece of a split message
+    if (frag == 0 && *split) { *split = 0; return 0; }     // its last piece
+    if (frag == 1) *split = 1;                             // its first piece, which carries the head
+    if (12 + optn + 5 > n) return 0;
+    const uint8_t *m = b + 12 + optn; unsigned left = n - 12 - optn;
+    unsigned proto = m[4] & 0x7f, call = m[4] >> 7, at = 5;
+    if (proto == 0x7f) { if (left < 7) return 0; proto = m[5] | (unsigned)m[6] << 8; at = 7; }
+    if (call) {
+        if (left < at + 8) return 0;
+        uint32_t id = le32(m + at), method = le32(m + at + 4);
+        const uint8_t *body = m + at + 8; unsigned bl = left - at - 8;
+        if (proto == 3 && method == 5 && bl >= 12) {   // ReportNATProperties(mapping, filtering, round trip): what Pia's NAT check concluded
+            LOG("[nextendo] NEX: the game reports its NAT to the server: mapping %u, filtering %u, round trip %u ms (mapping: 1 the same port to every server, 2 a port per server, 0 not found out; filtering: 1 open, 2 by port, 0 not found out)", le32(body), le32(body + 4), le32(body + 8));
+            return 1;
+        }
+        if (proto == 3 && (method == 4 || method == 7) && bl >= (method == 7 ? 13u : 9u)) {   // ReportNATTraversalResult(station, ok, [detail,] round trip)
+            LOG("[nextendo] NEX: the game reports a hole punch to another player: %s, round trip %u ms", body[4] ? "it worked" : "FAILED", le32(body + (method == 7 ? 9 : 5)));
+            return 1;
+        }
+        if (proto == 0x0a && (method == 1 || method == 2 || method == 3)) {   // the login: who the server is being told we are
+            NXLOG("NEX: %s call %u: %s %#x method %u (%llu bytes)", who, id, nex_protocol(proto), proto, method, (unsigned long long)total);
+            nex_login_note(body, bl, method);
+            return 1;
+        }
+        // Where the addresses for a hole punch are settled: the game's own stations at secure connection Register (1) and ReplaceURL (7), and
+        // the other player's at match making GetSessionURLs (0x15 method 41)
+        if ((proto == 0x0b && (method == 1 || method == 7)) || (proto == 0x15 && method == 41)) {
+            NXLOG("NEX: %s call %u: %s %#x method %u (%llu bytes)", who, id, nex_protocol(proto), proto, method, (unsigned long long)total);
+            nex_stations(body, bl, proto == 0x0b ? "the game registers its own" : "asked for");
+            return 1;
+        }
+        if (quiet && proto != 3) return 0;
+        NXLOG("NEX: %s call %u: %s %#x method %u (%llu bytes)", who, id, nex_protocol(proto), proto, method, (unsigned long long)total);
+        return 1;
+    }
+    if (left < at + 1) return 0;
+    if (m[at]) {
+        if (left < at + 9) return 0;
+        unsigned method = le32(m + at + 5) & ~0x8000u;
+        if ((proto == 0x0b && (method == 1 || method == 7)) || (proto == 0x15 && method == 41)) {
+            NXLOG("NEX: %s answer to call %u: %s %#x method %u (%llu bytes)", who, le32(m + at + 1), nex_protocol(proto), proto, method, (unsigned long long)total);
+            nex_stations(m + at + 9, left - at - 9, proto == 0x15 ? "the server gives us for the session" : "the server kept for us");
+            return 1;
+        }
+        if (quiet && proto != 3) return 0;
+        NXLOG("NEX: %s answer to call %u: %s %#x method %u (%llu bytes)", who, le32(m + at + 1), nex_protocol(proto), proto, method, (unsigned long long)total);
+        return 1;
+    }
+    if (left < at + 9) return 0;
+    LOG("[nextendo] NEX: %s call %u FAILED: %s %#x, result %#x", who, le32(m + at + 5), nex_protocol(proto), proto, le32(m + at + 1));   // always logged
+    return 1;
+}
+// One direction's WebSocket frame headers, read as the bytes pass, and the first bytes of each binary frame for nex_note (the rest of a payload is skipped, never
+// kept, except a close frame's)
+- (void)scan:(const uint8_t *)p n:(size_t)n dir:(int)dir {
+    if (!nx_log_on()) return;
+    typeof(ws[0]) *w = &ws[dir];
+    NSMutableData *__strong *cb = &cbody[dir];
+    while (n) {
+        if (w->skip) {
+            size_t k = (size_t)(w->skip < n ? w->skip : n);
+            if (*cb && (*cb).length < 125) [*cb appendBytes:p length:MIN(k, 125 - (*cb).length)];
+            for (size_t i = 0; i < k && w->capn < sizeof w->cap; i++, w->pos++) w->cap[w->capn++] = p[i] ^ (w->masked ? w->mask[w->pos & 3] : 0);
+            p += k; n -= k; w->skip -= k;
+            if (!w->skip && w->op == 2) nnex += nex_note(w->cap, w->capn, w->len, dir, &split[dir], nnex >= 400);
+            if (!w->skip && *cb) {
+                const uint8_t *b = (*cb).bytes; NSUInteger bl = (*cb).length;
+                int code = bl >= 2 && dir == 1 ? b[0] << 8 | b[1] : -1;
+                NSString *why = bl > 2 && dir == 1 ? [[NSString alloc] initWithBytes:b + 2 length:bl - 2 encoding:NSUTF8StringEncoding] : nil;
+                LOG("[nextendo] bridge: %s sends a WebSocket close (code %d%s%s)", dir ? "the server" : "the game", code, why.length ? ", " : "", why.UTF8String ?: "");
+                *cb = nil;
+            }
+            continue;
+        }
+        w->h[w->have++] = *p++; n--;
+        if (w->have < 2) continue;
+        int masked = w->h[1] >> 7, l7 = w->h[1] & 0x7f, need = 2 + (l7 == 126 ? 2 : l7 == 127 ? 8 : 0) + (masked ? 4 : 0);
+        if (w->have < need) continue;
+        uint64_t len = l7;
+        if (l7 == 126) len = (uint64_t)w->h[2] << 8 | w->h[3];
+        else if (l7 == 127) { len = 0; for (int i = 0; i < 8; i++) len = len << 8 | w->h[2 + i]; }
+        int op = w->h[0] & 0x0f;
+        if (nframes[dir]++ < 12 || op == 8) NXLOG("bridge: %s frame opcode %d, %llu bytes", dir ? "server → game" : "game → server", op, (unsigned long long)len);
+        *cb = op == 8 && dir == 1 ? [NSMutableData data] : nil;
+        if (op == 8 && dir == 0) NXLOG("bridge: the game sends a WebSocket close");
+        w->op = op; w->masked = masked; w->len = len; w->pos = 0; w->capn = 0;
+        if (masked) memcpy(w->mask, w->h + need - 4, 4);
+        w->skip = len; w->have = 0;
+        if (!len && *cb) { LOG("[nextendo] bridge: the server sends a WebSocket close (no code)"); *cb = nil; }
+    }
+}
+- (void)logHead:(NSData *)head who:(const char *)who {   // the request or status line and the header names (values only of the harmless ones)
+    if (!nx_log_on()) return;
+    NSString *s = [[NSString alloc] initWithData:head encoding:NSISOLatin1StringEncoding];
+    for (NSString *ln in [s componentsSeparatedByString:@"\r\n"]) {
+        if (!ln.length) continue;
+        NSRange c = [ln rangeOfString:@":"];
+        NSString *k = c.location == NSNotFound ? nil : [ln substringToIndex:c.location].lowercaseString;
+        BOOL show = !k || [@[@"host", @"upgrade", @"connection", @"sec-websocket-protocol", @"sec-websocket-version", @"server", @"content-type", @"content-length"] containsObject:k];
+        LOG("[nextendo] bridge: %s: %s", who, (show ? ln : [k stringByAppendingString:@": …"]).UTF8String);
+    }
+}
+- (void)close {
+    if (closed) return;
+    closed = 1;
+    NXLOG("bridge: closed after %llu bytes to the server and %llu from it", (unsigned long long)sent, (unsigned long long)got);
+    if (rd) { dispatch_source_cancel(rd); rd = nil; } else if (fd >= 0) close(fd);
+    if (conn) nw_connection_cancel(conn);
+    conn = nil;
+}
+// The first request's header: its Host line names the game server
+- (NSData *)fixHeader:(NSData *)req {
+    NSString *s = [[NSString alloc] initWithData:req encoding:NSISOLatin1StringEncoding];
+    NSMutableArray *lines = [[s componentsSeparatedByString:@"\r\n"] mutableCopy];
+    for (NSUInteger i = 1; i < lines.count; i++)
+        if ([[lines[i] lowercaseString] hasPrefix:@"host:"]) { lines[i] = [@"Host: " stringByAppendingString:sni]; break; }
+    return [[lines componentsJoinedByString:@"\r\n"] dataUsingEncoding:NSISOLatin1StringEncoding];
+}
+- (void)upstream:(NSData *)d {
+    if (closed) return;
+    if (!header_done) {
+        if (d) [pending appendData:d];
+        NSRange end = [pending rangeOfData:[NSData dataWithBytes:"\r\n\r\n" length:4] options:0 range:NSMakeRange(0, pending.length)];
+        if (end.location == NSNotFound) { if (pending.length > 16384) header_done = 1; else return; }
+        else {
+            NSData *head = [self fixHeader:[pending subdataWithRange:NSMakeRange(0, end.location + 4)]];
+            NSMutableData *rest = [head mutableCopy];
+            [rest appendData:[pending subdataWithRange:NSMakeRange(end.location + 4, pending.length - end.location - 4)]];
+            pending = rest; header_done = 1;
+            [self logHead:head who:"game's request"];
+            wsproto = ws_protocol(head);
+            wskey = head_value(head, @"sec-websocket-key");
+            if (pending.length > head.length) [self scan:(const uint8_t *)pending.bytes + head.length n:pending.length - head.length dir:0];
+        }
+        d = nil;
+    } else {
+        if (d) [self scan:d.bytes n:d.length dir:0];
+        if (!ready) { if (d) [pending appendData:d]; return; }
+    }
+    if (!ready) return;
+    NSData *out = d;
+    if (pending.length) { NSMutableData *m = pending; if (d) [m appendData:d]; out = m; pending = [NSMutableData data]; }
+    if (!out.length) return;
+    sent += out.length;
+    dispatch_data_t dd = dispatch_data_create(out.bytes, out.length, q, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+    nw_connection_send(conn, dd, NW_CONNECTION_DEFAULT_MESSAGE_CONTEXT, true, ^(nw_error_t e) { if (e) { NXLOG("bridge: send failed"); [self close]; } });
+}
+- (void)receive {
+    if (closed) return;
