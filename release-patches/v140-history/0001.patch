+                    if (e2.location != NSNotFound) head = ws_fix_accept(ws_fix_answer(head, self->wsproto), self->wskey);
+                    NSMutableData *all = [head mutableCopy];
+                    [all appendData:[self->rhead subdataWithRange:NSMakeRange(hl, self->rhead.length - hl)]];
+                    if (self->rhead.length > hl) [self scan:(const uint8_t *)self->rhead.bytes + hl n:self->rhead.length - hl dir:1];
+                    self->rhead = nil;
+                    held = all; p = held.bytes; size = held.length;
+                } else [self scan:p n:size dir:1];
+                while (size) {   // the game's end is a local socket: a short wait at most when its buffer is full
+                    ssize_t w = write(self->fd, p, size);
+                    if (w > 0) { p += w; size -= (size_t)w; continue; }
+                    if (w < 0 && (errno == EAGAIN || errno == EINTR)) { struct timespec ts = {0, 1000000}; nanosleep(&ts, NULL); continue; }
+                    bad = 1; return false;
+                }
+                return true;
+            });
+            if (bad) { [self close]; return; }
+        }
+        if (e || (complete && !content)) { NXLOG("bridge: the game server closed the connection"); [self close]; return; }
+        [self receive];
+    });
+}
+@end
+
+static NSMutableSet *g_bridges;   // keeps each bridge alive until it closes (on its own queue)
+
+static int bridge_open_(const char *sni, int rewrite_host, uint16_t port);
+int nx_bridge_open(const char *sni, int rewrite_host, uint16_t port) {
+    if (!dm_net_online()) { errno = ENETDOWN; return -1; }
+    __block int fd = -1, err = 0;
+    on_host_thread(^{ fd = bridge_open_(sni, rewrite_host, port); err = errno; });
+    if (fd < 0) errno = err;
+    return fd;
+}
+static int bridge_open_(const char *sni, int rewrite_host, uint16_t port) {
+    int sv[2];
+    if (socketpair(AF_UNIX, SOCK_STREAM, 0, sv)) return -1;
+    int nos = 1;
+    setsockopt(sv[0], SOL_SOCKET, SO_NOSIGPIPE, &nos, sizeof nos);
+    setsockopt(sv[1], SOL_SOCKET, SO_NOSIGPIPE, &nos, sizeof nos);
+    fcntl(sv[1], F_SETFL, fcntl(sv[1], F_GETFL) | O_NONBLOCK);
+    NxBridge *b = [NxBridge new];
+    b->fd = sv[1];
+    b->q = dispatch_queue_create("nextendo.bridge", DISPATCH_QUEUE_SERIAL);
+    b->pending = [NSMutableData data];
+    b->sni = @(sni && *sni ? sni : nx_game_host());
+    b->header_done = !rewrite_host;
+    NSString *server_name = b->sni;
+    char ip[16];
+    struct in_addr ia = {htonl(C.server)};
+    inet_ntop(AF_INET, &ia, ip, sizeof ip);
+    char ports[8]; snprintf(ports, sizeof ports, "%u", port ? port : C.server_port);
+    nw_endpoint_t ep = nw_endpoint_create_host(ip, ports);
+    nw_parameters_t params = nw_parameters_create_secure_tcp(^(nw_protocol_options_t tls) {
+        sec_protocol_options_t so = nw_tls_copy_sec_protocol_options(tls);
+        sec_protocol_options_set_tls_server_name(so, server_name.UTF8String);
+        sec_protocol_options_set_min_tls_protocol_version(so, tls_protocol_version_TLSv12);
+        sec_protocol_options_set_verify_block(so, ^(sec_protocol_metadata_t md, sec_trust_t trust, sec_protocol_verify_complete_t complete) {
+            (void)md;
+            int ok = trust_matches_pin(trust, server_name.UTF8String);
+            if (!ok) LOG("[nextendo] not connecting to %s: its key is not pinned (DM_NEXTENDO_PIN)", server_name.UTF8String);
+            complete(ok);
+        }, b->q);
+    }, ^(nw_protocol_options_t tcp) { nw_tcp_options_set_no_delay(tcp, true); });
+    b->conn = nw_connection_create(ep, params);
+    nw_connection_set_queue(b->conn, b->q);
+    @synchronized (NxBridge.class) { if (!g_bridges) g_bridges = [NSMutableSet set]; [g_bridges addObject:b]; }
+    __weak NxBridge *wb = b;
+    nw_connection_set_state_changed_handler(b->conn, ^(nw_connection_state_t st, nw_error_t e) {
+        NxBridge *s = wb; if (!s) return;
+        if (st == nw_connection_state_ready) {
+            NXLOG("bridge: TLS to the game server is up");
+            s->ready = 1;
+            [s upstream:nil];
+            [s receive];
+        } else if (st == nw_connection_state_waiting) {   // no route yet (the network is coming up, or refused once): it retries by itself
+            NXLOG("bridge: waiting for a route to the game server");
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC), s->q, ^{
+                NxBridge *s2 = wb;
+                if (s2 && !s2->ready && !s2->closed) { LOG("[nextendo] cannot reach the game server (no route for 10 s)"); [s2 close]; }
+            });
+        } else if (st == nw_connection_state_failed) {
+            LOG("[nextendo] cannot reach the game server (error)");
+            [s close];
+        } else if (st == nw_connection_state_cancelled) {
+            @synchronized (NxBridge.class) { [g_bridges removeObject:s]; }
+        }
+    });
+    b->rd = dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, (uintptr_t)sv[1], 0, b->q);
+    int hostfd = sv[1];
+    dispatch_source_set_event_handler(b->rd, ^{
+        NxBridge *s = wb; if (!s) return;
+        uint8_t buf[65536];
+        ssize_t n = read(hostfd, buf, sizeof buf);
+        if (n > 0) [s upstream:[NSData dataWithBytes:buf length:(size_t)n]];
+        else if (n == 0 || (errno != EAGAIN && errno != EINTR)) { NXLOG("bridge: the game closed its end"); [s close]; }
+    });
+    dispatch_source_set_cancel_handler(b->rd, ^{ close(hostfd); });
+    dispatch_resume(b->rd);
+    nw_connection_start(b->conn);
+    NXLOG("bridge: connecting to the game server");
+    return sv[0];
+}
