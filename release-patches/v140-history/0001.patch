+// The game's NEX login job (observation gate OBS_NEX_LOGIN, dm/games/01006A800016E000/patches.py): its NgsFacade is at +360 of the job (x0). The facade
+// can carry a direct server address, which no retail code sets: the host at +576 (an nn::nex::String: its characters' pointer at +24 and its capacity at
+// +32) and the port at +616. Set, NEX opens its WebSocket to that address without TLS, and the bridge (net_nextendo_apple.m) adds the TLS. Facts of
+// Super Smash Bros. Ultimate 13.0.5, as WindowSmash found them (github.com/OpenSmash-Ultimate/WindowSmash, runtime/hle_online.c)
+static void obs_nex_login(uint64_t *regs, int param) {
+    (void)param;
+    if (!dm_net_online() || !regs[0]) return;
+    uint8_t *facade = *(uint8_t **)(regs[0] + 360);
+    if (!facade) return;
+    char *data = *(char **)(facade + 576 + 24);
+    uint64_t cap = *(uint64_t *)(facade + 576 + 32);
+    const char host[] = "10.13.37.1";   // NX_BRIDGE_IP
+    if (!data || cap <= strlen(host)) { LOG("[nextendo] NEX login: no room for the bridge's address; the game's own server is left, and its login fails"); return; }
+    memcpy(data, host, sizeof host);
+    *(uint16_t *)(facade + 616) = NX_BRIDGE_PORT;
+    NXLOG("NEX login through the bridge");
+    nx_account_ready(0);   // signs in now if needed, before the login asks for the ID token
+}
+// A Pia job that ends in failure (observation gate OBS_PIA_FAIL, the same patches.py): Pia keeps its own result codes, which never reach an
+// nn::err::ErrorResultVariant, so a failed NAT check or session join leaves no other trace than the game's own dialog. The function (main+0xb41f0 in
+// 13.0.5, WindowSmash's finding, runtime/hle_net.c) marks a job failed with the result [x1] points at; where it was called from names the job
+static void obs_pia_fail(uint64_t *regs, int param) {
+    (void)param;
+    if (!dm_net_online()) return;
+    static _Atomic int n;
+    if (atomic_fetch_add(&n, 1) >= 64) return;
+    // The function was found for 13.0.5 by its first instruction, and the result is meant to be the word x1 points at. The first log it produced
+    // had neither a Pia-looking result nor a caller inside any module, so the registers here are not what that reading assumed: until the
+    // function is disassembled on this build, the line says what the registers hold and claims nothing about them. The moment it fires is still
+    // worth having, since Pia keeps its results to itself and nothing else marks the failure
+    uint32_t r = regs[1] > 0x10000 && !(regs[1] & 3) ? *(const uint32_t *)regs[1] : 0;
+    const void *lr = (const void *)regs[30];
+    module_t *m = module_of(lr);
+    if (m) LOG("[nextendo] a Pia job failed: result %u (%#x), from %s+%#llx", r, r, m->name, (unsigned long long)((const uint8_t *)lr - m->base));
+    else LOG("[nextendo] a Pia job gate fired (x0 %#llx, x1 %#llx, x30 %#llx: no caller inside a module, so these are not the job and its result — the gate's address wants checking on this build)",
+             (unsigned long long)regs[0], (unsigned long long)regs[1], (unsigned long long)regs[30]);
+}
+__attribute__((constructor)) static void net_obs_init(void) { gate_obs_set(OBS_NEX_LOGIN, obs_nex_login); gate_obs_set(OBS_PIA_FAIL, obs_pia_fail); }
