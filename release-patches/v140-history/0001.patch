+// Online play through Nextendo Network (https://nextendo.network), a community server for Switch games: the host's side of it.
+// Off unless DM_NEXTENDO=1 and the game is one this host knows how to take online (Super Smash Bros. Ultimate 13.0.5 and Mario Kart 8 Deluxe 4.0.1 so far). Off, every
+// network call keeps its offline answer (hle_net.c, hle_account.c), so no other game changes.
+//
+// The pieces (docs/nextendo.md has the whole picture):
+//   account   a Nextendo account signed in with OAuth 2.0 (authorization code + PKCE, public client) in an in-app browser sheet whose redirect
+//             a listener on 127.0.0.1 catches; the refresh token in the Keychain; at need, GET /api/nex-token for the game's NEX login token
+//             (net_nextendo_apple.m)
+//   id token  the network service account ID token the game hands its NEX login: a JWT shaped like Nintendo BaaS's, carrying the Nextendo
+//             PID as "sub" and the NEX login token as "nnex", which is what Nextendo's game server checks
+//   names     every name of Nintendo's the game resolves (nintendo.net, .com, .co.jp, nintendowifi.net) is Nextendo's: nncs2-* (Pia's second
+//             NAT check server) is their NAT check, every other one their game server. Nothing else resolves
+//   TLS       nn::ssl: a connection's handshake on a socket connected to the game server puts the bridge in the socket's place, so the game's
+//             own TLS client (NEX over nn::ssl: Mario Kart 8 Deluxe; the account API every game asks before an online action) reads and
+//             writes plain bytes the bridge carries in TLS, the key pinned. So a connection to the server on 443 is left plain for it
+//   NEX       (Super Smash Bros. Ultimate) the game's NEX client is pointed at a stand-in address (NX_BRIDGE_IP, observation gate OBS_NEX_LOGIN on its login job) where it
+//             speaks its WebSocket without TLS; a TCP connection there is a bridge that carries it to Nextendo's game server in TLS, the
+//             server's key pinned (Network.framework). Pia's UDP goes straight to the other players, as on a console
+//
+// Switches (environment; the launcher's "Nextendo online" row sets the first):
+//   DM_NEXTENDO=1               go online through Nextendo
+//   DM_NEXTENDO_CLIENT_ID       the OAuth client ID of your own application at nextendo.network/developers (default: NX_CLIENT_ID_DEFAULT)
+//   DM_NEXTENDO_REDIRECT_PORT   the loopback port of its registered redirect, http://127.0.0.1:<port>/callback (default 47823)
+//   DM_NEXTENDO_API             the account API (default https://nextendo.network)
+//   DM_NEXTENDO_SERVER          the game server, a dotted IPv4 address[:port] (default NX_SERVER_DEFAULT:443)
+//   DM_NEXTENDO_NAT             the NAT check server, a dotted IPv4 address (default NX_NAT_DEFAULT)
+//   DM_NEXTENDO_PIN             the pinned public keys: SHA-256 of each SubjectPublicKeyInfo, 64 hex digits, commas between several (default NX_PIN_DEFAULT).
+//                               Their router fronts more than the game server, and a backend of theirs may hold a key of its own; a key that is not pinned is
+//                               refused and its hash logged, to be added here
+//   DM_NEXTENDO_LOG=1           log every socket, name and bridge event, the NEX calls by number and the failures the game records (the PID, tokens and codes are never logged)
+//   DM_NEXTENDO_SIGNOUT=1       forget the stored account at start (the next online step asks to sign in again)
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+// Your application's client ID (nextendo.network → Developers → New application: public, PKCE, redirect http://127.0.0.1:47823/callback,
+// scopes identity and game.matchmaking). This is the fork's own application; DM_NEXTENDO_CLIENT_ID names another.
+#define NX_CLIENT_ID_DEFAULT "nxc_iCNSyIfLdS5o"
+// Nextendo's addresses as Super Mario Bros. 35 Recomp ships them (github.com/sm35recomp/sm35recomp, recomp/runtime/net/netcfg.h). Not yet
+// confirmed for Super Smash Bros. Ultimate: ask Nextendo, and override with the switches above if theirs differ.
+#define NX_SERVER_DEFAULT "51.178.29.194"
+#define NX_NAT_DEFAULT "164.132.111.120"
+#define NX_PIN_DEFAULT "d2e7388e48ee30cfbecfbeb522874f2cc6b85f7aa1105c57669f3c2aa85fb30e"
+#define NX_PINS 8                     // pins DM_NEXTENDO_PIN may hold
+#define NX_BRIDGE_IP 0x0A0D2501u      // 10.13.37.1, host order: the stand-in address the game's NEX client is given
+#define NX_BRIDGE_PORT 443
+
+int dm_net_online(void);              // DM_NEXTENDO=1 and the running game is supported; read once
+int nx_log_on(void);
+#define NXLOG(...) do { if (nx_log_on()) LOG("[nextendo] " __VA_ARGS__); } while (0)
+
+// The running game's NEX game server name (the SNI and Host of the bridge) and its version text for the ID token
+const char *nx_game_host(void);
+const char *nx_game_version(void);
+
+// Names (host order). 1 and *ip for a dotted address or one of Nintendo's names while online, 0 for anything else
+int nx_resolve(const char *name, uint32_t *ip);
+// May a game socket reach ip (host order)? TCP: the bridge, the game server and the NAT check. UDP: any address (Pia's peers)
+int nx_dest_allowed(uint32_t ip, int udp);
+
+// A TCP connection to the bridge: a connected host stream socket whose other end the bridge carries to the game server in TLS. -1 on failure
+// (errno set). The game's descriptor wraps the returned socket like any other. sni: the server name the TLS connection asks for (NULL: the
+// running game's, nx_game_host). rewrite_host: the first request's Host header becomes that name (the NEX login sent to the stand-in address).
+// port: the server port to dial (0: the configured one, DM_NEXTENDO_SERVER's). The game's secure (post-login) connection names its own port
+int nx_bridge_open(const char *sni, int rewrite_host, uint16_t port);
+int nx_is_server(uint32_t ip);        // ip (host order) is Nextendo's game server
+
+// The account. nx_account_ready signs in when no account is stored (an in-app browser sheet; the caller's thread waits, up to timeout_ms)
+// and makes sure a fresh NEX login token is in hand. 1 when ready
+int nx_account_ready(int timeout_ms);
+uint64_t nx_pid(void);                          // 0 until nx_account_ready
+size_t nx_id_token(char *out, size_t cap);      // the ID token's length, 0 when there is none (no account, or no game token)
+int nx_username(char *out, size_t cap);         // the Nextendo user name, 1 when known
+
+// The local IPv4 address of the interface the default route uses (host order), 0 when none: Pia puts it in its station URL
+uint32_t nx_local_ip(void);
