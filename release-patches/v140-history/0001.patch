+static int on_wait(int h, short events, int64_t ms) {
+    uint64_t start = now_ns();
+    for (;;) {
+        if (dm_teardown_is_parking()) { dm_teardown_check_current_thread(); return -1; }
+        int64_t left = ms < 0 ? 50 : ms - (int64_t)((now_ns() - start) / 1000000);
+        if (left <= 0 && ms >= 0) return 0;
+        struct pollfd p = {h, events, 0};
+        dm_thread_native_wait(1);
+        int r = poll(&p, 1, (int)(left > 50 ? 50 : left));
+        dm_thread_native_wait(0);
+        if (r > 0) return 1;
+        if (r < 0 && errno != EINTR) return 1;   // let the call itself report the error
