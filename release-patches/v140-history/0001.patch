+// ---------- the ID token ----------
+#define NX_BAAS_ISS "https://e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com"
+#define NX_BAAS_AUD "ed9e2f05d286f7b8"   // the network service account's client ID that BaaS ID tokens name
+static SecKeyRef g_jwt_key; static NSString *g_device_id;
+static int jwt_key_load(void) {   // with g_acc_m held
+    if (g_jwt_key) return 1;
+    NSData *der = kc_get(@"jwt_key");
+    NSDictionary *attrs = @{(__bridge id)kSecAttrKeyType: (__bridge id)kSecAttrKeyTypeRSA, (__bridge id)kSecAttrKeyClass: (__bridge id)kSecAttrKeyClassPrivate};
+    if (der) g_jwt_key = SecKeyCreateWithData((__bridge CFDataRef)der, (__bridge CFDictionaryRef)attrs, NULL);
+    if (!g_jwt_key) {
+        CFErrorRef e = NULL;
+        g_jwt_key = SecKeyCreateRandomKey((__bridge CFDictionaryRef)@{(__bridge id)kSecAttrKeyType: (__bridge id)kSecAttrKeyTypeRSA,
+                                                                      (__bridge id)kSecAttrKeySizeInBits: @2048}, &e);
+        if (!g_jwt_key) { LOG("[nextendo] could not make the ID token's key"); if (e) CFRelease(e); return 0; }
+        CFDataRef ext = SecKeyCopyExternalRepresentation(g_jwt_key, NULL);
+        if (ext) { kc_set(@"jwt_key", (__bridge NSData *)ext); CFRelease(ext); }
+    }
+    g_device_id = kc_str(@"device_id");
+    if (g_device_id.length != 16) {
+        const uint8_t *b = random_data(8).bytes;
+        g_device_id = [NSString stringWithFormat:@"%02x%02x%02x%02x%02x%02x%02x%02x", b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]];
+        kc_set_str(@"device_id", g_device_id);
+    }
+    return 1;
+}
+static size_t id_token_(char *out, size_t cap);
+size_t nx_id_token(char *out, size_t cap) {
+    if (!dm_net_online() || !cap) return 0;
+    __block size_t n = 0;
+    on_host_thread(^{ n = id_token_(out, cap); });
+    return n;
+}
+static size_t id_token_(char *out, size_t cap) {
+    pthread_mutex_lock(&g_acc_m);
+    size_t n = 0;
+    if (A.nex.length && A.pid && jwt_key_load()) {
+        long long now = (long long)time(NULL);
+        NSString *jti = NSUUID.UUID.UUIDString.lowercaseString;
+        unsigned long long tid = strtoull(dm_profile()->id, NULL, 16);
+        NSString *claims = [NSString stringWithFormat:
+            @"{\"iss\":\"" NX_BAAS_ISS "\",\"jku\":\"" NX_BAAS_ISS "/1.0.0/certificates\",\"aud\":\"" NX_BAAS_AUD "\",\"sub\":\"%016llx\",\"iat\":%lld,\"exp\":%lld,"
+             "\"jti\":\"%@\",\"typ\":\"id_token\",\"di\":\"%@\",\"bs:did\":\"%@\",\"sn\":\"XAW10000000000\",\"hm\":true,\"nintendo\":{\"ai\":\"%016llx\",\"av\":\"%s\"},"
+             "\"tv\":\"%s\",\"nnex\":\"%@\"}",
+            (unsigned long long)A.pid, now, now + 3 * 3600, jti, g_device_id, g_device_id, tid, nx_game_version(), nx_game_version(), A.nex];
+        NSString *header = @"{\"alg\":\"RS256\",\"typ\":\"JWT\",\"kid\":\"nextendo-baas-key-1\"}";
+        NSString *signing = [NSString stringWithFormat:@"%@.%@", b64url([header dataUsingEncoding:NSUTF8StringEncoding]), b64url([claims dataUsingEncoding:NSUTF8StringEncoding])];
+        CFDataRef sig = SecKeyCreateSignature(g_jwt_key, kSecKeyAlgorithmRSASignatureMessagePKCS1v15SHA256, (__bridge CFDataRef)[signing dataUsingEncoding:NSUTF8StringEncoding], NULL);
+        if (sig) {
+            NSString *tok = [NSString stringWithFormat:@"%@.%@", signing, b64url((__bridge NSData *)sig)];
+            CFRelease(sig);
+            const char *t = tok.UTF8String;
+            if (strlen(t) < cap) { memcpy(out, t, strlen(t) + 1); n = strlen(t); }
+            else LOG("[nextendo] the ID token (%zu bytes) does not fit the game's buffer (%zu)", strlen(t), cap);
+        }
+    }
+    pthread_mutex_unlock(&g_acc_m);
+    if (!n) out[0] = 0;
+    return n;
+}
