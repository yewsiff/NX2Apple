+// ---------- the TLS bridge ----------
+// The game's end is a stream socket of a socketpair; the host's end is read with a dispatch source and written to a Network.framework TLS
+// connection to the game server, whose key must hash to the pin. Until the TLS connection is ready, what the game sends waits. The first
+// request (the WebSocket upgrade, sent to the stand-in address) gets the game server's real name as its Host.
+static NSData *spki_der(SecKeyRef key) {   // the key's SubjectPublicKeyInfo, as DER: what a pin hashes
+    CFDataRef raw = SecKeyCopyExternalRepresentation(key, NULL);
+    if (!raw) return nil;
+    NSData *k = (__bridge_transfer NSData *)raw;
+    NSDictionary *at = (__bridge_transfer NSDictionary *)SecKeyCopyAttributes(key);
+    NSString *type = at[(__bridge id)kSecAttrKeyType];
+    int bits = [at[(__bridge id)kSecAttrKeySizeInBits] intValue];
+    static const uint8_t rsa[] = {0x30, 0x0d, 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01, 0x05, 0x00};
+    static const uint8_t p256[] = {0x30, 0x13, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07};
+    static const uint8_t p384[] = {0x30, 0x10, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01, 0x06, 0x05, 0x2b, 0x81, 0x04, 0x00, 0x22};
+    const uint8_t *alg; size_t alen;
+    if ([type isEqualToString:(__bridge NSString *)kSecAttrKeyTypeRSA]) { alg = rsa; alen = sizeof rsa; }
+    else if ([type isEqualToString:(__bridge NSString *)kSecAttrKeyTypeECSECPrimeRandom] && bits == 256) { alg = p256; alen = sizeof p256; }
+    else if ([type isEqualToString:(__bridge NSString *)kSecAttrKeyTypeECSECPrimeRandom] && bits == 384) { alg = p384; alen = sizeof p384; }
+    else return nil;
+    void (^len)(NSMutableData *, size_t) = ^(NSMutableData *d, size_t n) {
+        uint8_t b[5]; size_t m = 0;
+        if (n < 0x80) b[m++] = (uint8_t)n;
+        else { size_t t = n; int k2 = 0; while (t) { k2++; t >>= 8; } b[m++] = (uint8_t)(0x80 | k2); for (int i = k2 - 1; i >= 0; i--) b[m++] = (uint8_t)(n >> (8 * i)); }
+        [d appendBytes:b length:m];
+    };
+    NSMutableData *bit = [NSMutableData data]; uint8_t tag = 0x03, zero = 0;
+    [bit appendBytes:&tag length:1]; len(bit, k.length + 1); [bit appendBytes:&zero length:1]; [bit appendData:k];
+    NSMutableData *out = [NSMutableData data]; uint8_t seq = 0x30;
+    [out appendBytes:&seq length:1]; len(out, alen + bit.length); [out appendBytes:alg length:alen]; [out appendData:bit];
+    return out;
+}
+// 1 when the server's key hashes to one of the configured pins. On a mismatch the hash it does have is logged, so a backend of theirs with a key
+// of its own can be named in DM_NEXTENDO_PIN rather than guessed at (the hash is public: it is in every handshake with that server)
+static int trust_matches_pin(sec_trust_t trust, const char *sni) {
+    SecTrustRef t = sec_trust_copy_ref(trust);
+    if (!t) return 0;
+    int ok = 0;
+    if (SecTrustGetCertificateCount(t) > 0) {
+        SecKeyRef k = SecTrustCopyKey(t);
+        NSData *spki = k ? spki_der(k) : nil;
+        if (k) CFRelease(k);
+        if (spki) {
+            NSData *h = sha256(spki);
+            for (int i = 0; i < C.npin && !ok; i++) ok = !memcmp(h.bytes, C.pin[i], 32);
+            if (!ok) {
+                char hex[65]; const uint8_t *b = h.bytes;
+                for (int i = 0; i < 32; i++) snprintf(hex + 2 * i, 3, "%02x", b[i]);
+                LOG("[nextendo] the key %s presented is not one of the %d pinned: its SubjectPublicKeyInfo hashes to %s. Add it to DM_NEXTENDO_PIN (commas between pins) to allow it", sni && *sni ? sni : "the server", C.npin, hex);
+            }
+        }
+    }
+    CFRelease(t);
+    return ok;
+}
