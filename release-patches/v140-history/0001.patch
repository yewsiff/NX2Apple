+// Socket options. Horizon's numbers are FreeBSD's, and Apple's are the same only for the classic set: above it the same number is another option here (SOL_SOCKET
+// 0x800 is SO_NOSIGPIPE there and a timestamp option here; IP option 65 is IP_RECVTTL there and a background traffic class here). So only the options whose number and
+// meaning agree reach the host socket, the ones SM35 Recomp passes on (bsd_host.c map_opt): SOL_SOCKET reuse-address, keep-alive, broadcast, out-of-band inline,
+// reuse-port, the two buffer sizes, the error and the type; TCP no-delay; IP type-of-service and time-to-live. Every other option is accepted and kept, and read
+// back as it was set (zero when it never was): Nextendo's own Ryujinx build found a client that closes its socket when an option it set cannot be read back
+static int sk_opt_host(int level, int opt, int *hl) {
+    if (level == SK_SOL_SOCKET) { *hl = SOL_SOCKET; return opt == 0x4 || opt == 0x8 || opt == 0x20 || opt == 0x100 || opt == 0x200 || opt == 0x1001 || opt == 0x1002 || opt == SK_SO_ERROR || opt == SK_SO_TYPE; }
+    if (level == 6) { *hl = IPPROTO_TCP; return opt == 1; }
+    if (level == 0) { *hl = IPPROTO_IP; return opt == 3 || opt == 4; }
+    return 0;
+}
+static void sopt_keep(int fd, int level, int opt, const void *v, unsigned n) {
+    if (!v || !n) return;
+    pthread_mutex_lock(&g_efd_m);
+    if (sk_used(fd)) {
+        int at = -1;
+        for (int i = 0; i < SOPT_KEPT; i++) {
+            if (g_sopt[fd][i].n && g_sopt[fd][i].level == level && g_sopt[fd][i].opt == opt) { at = i; break; }
+            if (!g_sopt[fd][i].n && at < 0) at = i;
+        }
+        if (at >= 0) {
+            g_sopt[fd][at].level = level; g_sopt[fd][at].opt = opt; g_sopt[fd][at].n = n < sizeof g_sopt[fd][at].v ? n : (unsigned)sizeof g_sopt[fd][at].v;
+            memcpy(g_sopt[fd][at].v, v, g_sopt[fd][at].n);
+        }
+    }
+    pthread_mutex_unlock(&g_efd_m);
+}
+static unsigned sopt_kept(int fd, int level, int opt, void *v, unsigned cap) {   // the kept value's length, 0 when the option was never set
+    unsigned n = 0;
+    pthread_mutex_lock(&g_efd_m);
+    if (sk_used(fd))
+        for (int i = 0; i < SOPT_KEPT; i++)
+            if (g_sopt[fd][i].n && g_sopt[fd][i].level == level && g_sopt[fd][i].opt == opt) {
+                n = g_sopt[fd][i].n < cap ? g_sopt[fd][i].n : cap;
+                if (v) memcpy(v, g_sopt[fd][i].v, n);
+                break;
+            }
+    pthread_mutex_unlock(&g_efd_m);
+    return n;
+}
+static int on_setsockopt(int fd, int level, int opt, const void *v, unsigned n) {
+    int h = on_host(fd, NULL, NULL, NULL, NULL);
+    if (h < 0) return -1;
+    BTRACE(fd, "socket %d: setsockopt level %#x option %#x (%u bytes)", fd, level, opt, n);
+    if (level == SK_SOL_SOCKET && (opt == SK_SO_RCVTIMEO || opt == SK_SO_SNDTIMEO)) {   // kept here: the host socket never blocks
+        int64_t tv[2] = {0, 0}; if (v) memcpy(tv, v, n < sizeof tv ? n : sizeof tv);
+        int64_t ms = tv[0] * 1000 + tv[1] / 1000;
+        pthread_mutex_lock(&g_efd_m);
+        if (sk_used(fd)) { if (opt == SK_SO_RCVTIMEO) g_efd[fd].rcv_ms = ms > 0 ? ms : -1; else g_efd[fd].snd_ms = ms > 0 ? ms : -1; }
+        pthread_mutex_unlock(&g_efd_m);
+        return 0;
+    }
+    int hl;
+    if (sk_opt_host(level, opt, &hl) && v && n) {   // each of them is an int
+        int x = 0; memcpy(&x, v, n < sizeof x ? n : sizeof x);
+        if (!setsockopt(h, hl, opt, &x, sizeof x)) return 0;
+        BTRACE(fd, "socket %d: option %#x/%#x not taken by the host socket (%s): kept as set", fd, level, opt, strerror(errno));   // (a TCP option on the bridge's local socket)
+    }
+    sopt_keep(fd, level, opt, v, n);
+    return 0;
+}
+static int on_getsockopt(int fd, int level, int opt, void *v, unsigned *n) {
+    int type; int64_t rcv, snd;
+    int h = on_host(fd, NULL, &type, &rcv, &snd);
+    if (h < 0) return -1;
+    BTRACE(fd, "socket %d: getsockopt level %#x option %#x", fd, level, opt);
+    unsigned cap = n ? *n : 0;
+    if (level == SK_SOL_SOCKET && (opt == SK_SO_RCVTIMEO || opt == SK_SO_SNDTIMEO)) {   // what setsockopt kept
+        int64_t ms = opt == SK_SO_RCVTIMEO ? rcv : snd;
+        int64_t tv[2] = {ms > 0 ? ms / 1000 : 0, ms > 0 ? ms % 1000 * 1000 : 0};
+        if (v) memcpy(v, tv, cap < sizeof tv ? cap : sizeof tv);
+        if (n) *n = sizeof tv;
+        return 0;
+    }
+    int hl;
+    if (sk_opt_host(level, opt, &hl)) {
+        int x = 0; socklen_t l = sizeof x;
+        if (!getsockopt(h, hl, opt, &x, &l)) {
+            if (level == SK_SOL_SOCKET && opt == SK_SO_ERROR && x) x = sk_err_linux(x);   // its value is an errno too
+            if (level == SK_SOL_SOCKET && opt == SK_SO_TYPE) x = type;                   // the game's own (a bridge's local socket is a stream as well, but not by this rule)
+            if (v) memcpy(v, &x, cap < sizeof x ? cap : sizeof x);
+            if (n) *n = sizeof x;
+            return 0;
+        }
+    }
+    if (v && cap) memset(v, 0, cap);
+    unsigned got = sopt_kept(fd, level, opt, v, cap);
+    if (n) *n = got ? got : cap < 4 ? cap : 4;
+    return 0;
+}
+static int on_fcntl(int fd, int cmd, int val) {
+    if (on_host(fd, NULL, NULL, NULL, NULL) < 0) return -1;
+    BTRACE(fd, "socket %d: fcntl %d %#x", fd, cmd, val);
+    pthread_mutex_lock(&g_efd_m);
+    int r = 0;
+    // O_RDWR, and the non-blocking bit where the game's library has it: 0x800 (Linux's O_NONBLOCK), not FreeBSD's 4. SM35 Recomp lists it among the fixes on its
+    // way to a played match, and Nextendo's own Ryujinx build and WindowSmash answer the same; a caller that reads the flags back to check, or to clear the bit, saw
+    // a blocking socket here before. F_SETFL still takes either bit
+    if (cmd == SK_F_GETFL) r = 2 | (g_efd[fd].nonblock ? SK_O_NONBLOCK_ALT : 0);
+    else if (cmd == SK_F_SETFL) g_efd[fd].nonblock = (val & (SK_O_NONBLOCK | SK_O_NONBLOCK_ALT)) != 0;
+    pthread_mutex_unlock(&g_efd_m);
+    return r;
+}
+// nn::socket::Ioctl. Horizon's requests are FreeBSD's: FIONBIO sets non-blocking from a 4-byte argument, FIONREAD reports what is
+// readable. sm35recomp implements exactly these two (bsd_host.c). Super Smash Bros. Ultimate 13.0.5 does not import Ioctl at all (its
+// Pia goes through the typed Socket / Bind / SendTo / RecvFrom and takes non-blocking from the socket type or the message flag), so
+// this serves other games. Any other request succeeds and changes nothing
+enum { SK_FIONBIO = 0x8004667e, SK_FIONREAD = 0x4004667f };
+static int on_ioctl(int fd, uint32_t req, void *arg) {
+    int h = on_host(fd, NULL, NULL, NULL, NULL);
+    if (h < 0) return -1;
+    if (req == SK_FIONBIO) {
+        int v = arg ? *(const int *)arg : 0;
+        pthread_mutex_lock(&g_efd_m);
+        if (sk_used(fd)) g_efd[fd].nonblock = v != 0;
+        pthread_mutex_unlock(&g_efd_m);
+        BTRACE(fd, "socket %d: ioctl FIONBIO %d", fd, v != 0);
+        return 0;
+    }
+    if (req == SK_FIONREAD) {
+        int avail = 0;
+        ioctl(h, FIONREAD, &avail);
+        if (arg) memcpy(arg, &avail, sizeof avail);
+        BTRACE(fd, "socket %d: ioctl FIONREAD -> %d", fd, avail);
+        return 0;
+    }
+    BTRACE(fd, "socket %d: ioctl %#x: nothing done, reported as done", fd, req);
+    return 0;
+}
+static int on_shutdown(int fd, int how) { int h = on_host(fd, NULL, NULL, NULL, NULL); return h < 0 ? -1 : shutdown(h, how) && errno != ENOTCONN ? on_err(errno) : 0; }
+// Poll over sockets and event descriptors alike (each event descriptor through its pipe)
+static int on_poll(sk_pollfd *p, uint64_t n, int ms) {
+    struct pollfd small[EFD_MAX], *hp = n <= EFD_MAX ? small : calloc(n, sizeof *hp);
+    if (!hp) return on_err(ENOMEM);
+    int ready = 0;
+    uint64_t start = now_ns();
+    for (;;) {
+        pthread_mutex_lock(&g_efd_m);
+        for (uint64_t i = 0; i < n; i++) {
+            int fd = p[i].fd;
+            hp[i].fd = -1; hp[i].events = 0; hp[i].revents = 0; p[i].revents = 0;
+            if (fd < 0) continue;
+            if (sk_used(fd)) { hp[i].fd = g_efd[fd].host; hp[i].events = p[i].events; }
+            else if (efd_used(fd)) {
+                if (g_efd[fd].count) p[i].revents |= p[i].events & (SK_POLLIN | SK_POLLRDNORM);
+                p[i].revents |= p[i].events & (SK_POLLOUT | SK_POLLWRNORM);
+                if (p[i].events & (SK_POLLIN | SK_POLLRDNORM)) { hp[i].fd = g_efd[fd].pr; hp[i].events = POLLIN; }
+            } else p[i].revents = SK_POLLNVAL;
+        }
+        pthread_mutex_unlock(&g_efd_m);
+        ready = 0;
+        for (uint64_t i = 0; i < n; i++) if (p[i].revents) ready++;
+        int64_t left = ms < 0 ? 50 : ms - (int64_t)((now_ns() - start) / 1000000);
+        int slice = ready ? 0 : (int)(left > 50 ? 50 : left < 0 ? 0 : left);
+        dm_thread_native_wait(1);
+        int r = poll(hp, (nfds_t)n, slice);
+        dm_thread_native_wait(0);
+        if (r > 0) {
+            pthread_mutex_lock(&g_efd_m);
+            for (uint64_t i = 0; i < n; i++) if (hp[i].revents && p[i].fd >= 0 && sk_used(p[i].fd)) {
+                int had = p[i].revents != 0;
+                p[i].revents |= hp[i].revents & (p[i].events | POLLERR | POLLHUP | POLLNVAL);
+                if (!had && p[i].revents) ready++;
+            }
+            pthread_mutex_unlock(&g_efd_m);
+            if (!ready) continue;   // only an event descriptor's pipe: its count is read again
+        }
+        if (ready || (ms >= 0 && left <= 0)) break;
+        if (dm_teardown_is_parking()) { dm_teardown_check_current_thread(); break; }
+    }
+    for (uint64_t i = 0; i < n; i++) if (p[i].fd >= 0 && p[i].revents) BTRACE(p[i].fd, "socket %d: poll events %#x -> revents %#x (%d ms)", p[i].fd, p[i].events, p[i].revents, ms);
+    if (hp != small) free(hp);
+    return ready;
+}
