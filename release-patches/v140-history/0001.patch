+// Compiled as part of web_apple.m, which includes it (see the end of that file); not a source of its own in the Makefile.
+// Nextendo Network on Apple platforms (net_online.h): the switches, the account (OAuth 2.0 + PKCE sign-in, the Keychain, the NEX login token),
+// the ID token, the names, and the TLS bridge that carries the game's NEX WebSocket to Nextendo's game server.
+//
+// Sign-in: GET <api>/oauth/authorize?response_type=code&client_id&redirect_uri=http://127.0.0.1:<port>/callback&scope=identity game.matchmaking
+// &state&code_challenge(S256), shown in an in-app browser sheet (ASWebAuthenticationSession) on the iPhone and in the default browser on the Mac;
+// a listener on 127.0.0.1:<port> takes the redirect, then POST <api>/oauth/token (grant_type=authorization_code, the verifier) gives an access
+// token and a refresh token. The refresh token and the user name are kept in the Keychain (service NX_KC_SERVICE), nothing else is. At the game's
+// online login: the refresh token gives an access token (grant_type=refresh_token), and GET <api>/api/nex-token with it gives
+// {"nex_token", "pid", "username", "expires_in"}. Tokens, codes, the verifier and the PID are never logged.
+//
+// The ID token is an RS256 JWT shaped like a network service account's (Nintendo BaaS): the game does not check its signature, Nextendo's server
+// reads the "nnex" claim. The RSA key is made once and kept in the Keychain with a random device ID.
+#include <TargetConditionals.h>
+#import <Foundation/Foundation.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#import <Security/Security.h>
+#import <Network/Network.h>
+#import <CommonCrypto/CommonDigest.h>
+#if TARGET_OS_IPHONE
+#import <UIKit/UIKit.h>
+#import <AuthenticationServices/AuthenticationServices.h>
