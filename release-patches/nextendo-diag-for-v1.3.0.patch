diff --git a/dm/host/hle_net.c b/dm/host/hle_net.c
index f989198..ad3c0bc 100644
--- a/dm/host/hle_net.c
+++ b/dm/host/hle_net.c
@@ -844,10 +844,16 @@ static void obs_pia_fail(uint64_t *regs, int param) {
     if (!dm_net_online()) return;
     static _Atomic int n;
     if (atomic_fetch_add(&n, 1) >= 64) return;
-    uint32_t r = regs[1] > 0x10000 && !(regs[1] & 3) ? *(const uint32_t *)regs[1] : 0;   // (a reference: the function's first act is to copy what it points at)
+    // The function was found for 13.0.5 by its first instruction, and the result is meant to be the word x1 points at. The first log it produced
+    // had neither a Pia-looking result nor a caller inside any module, so the registers here are not what that reading assumed: until the
+    // function is disassembled on this build, the line says what the registers hold and claims nothing about them. The moment it fires is still
+    // worth having, since Pia keeps its results to itself and nothing else marks the failure
+    uint32_t r = regs[1] > 0x10000 && !(regs[1] & 3) ? *(const uint32_t *)regs[1] : 0;
     const void *lr = (const void *)regs[30];
     module_t *m = module_of(lr);
-    LOG("[nextendo] a Pia job failed: result %u (%#x), reported from %s+%#llx", r, r, m ? m->name : "?", m ? (unsigned long long)((const uint8_t *)lr - m->base) : (unsigned long long)regs[30]);
+    if (m) LOG("[nextendo] a Pia job failed: result %u (%#x), from %s+%#llx", r, r, m->name, (unsigned long long)((const uint8_t *)lr - m->base));
+    else LOG("[nextendo] a Pia job gate fired (x0 %#llx, x1 %#llx, x30 %#llx: no caller inside a module, so these are not the job and its result — the gate's address wants checking on this build)",
+             (unsigned long long)regs[0], (unsigned long long)regs[1], (unsigned long long)regs[30]);
 }
 __attribute__((constructor)) static void net_obs_init(void) { gate_obs_set(OBS_NEX_LOGIN, obs_nex_login); gate_obs_set(OBS_PIA_FAIL, obs_pia_fail); }
 
diff --git a/dm/host/hle_offline.c b/dm/host/hle_offline.c
index e642fd5..0d89c63 100644
--- a/dm/host/hle_offline.c
+++ b/dm/host/hle_offline.c
@@ -162,12 +162,15 @@ HLE_FORCE("_ZN2nn4nifm22GetCurrentIpConfigInfoEPNS_6socket6InAddrES3_S3_S3_S3_",
     if (dm_net_online() && net_ip_config(a, b, c, d, e)) return RES_OK;
     uint32_t *p[5] = {a, b, c, d, e}; for (int i = 0; i < 5; i++) if (p[i]) *p[i] = 0; return RES_FAIL;
 }
+// The device's own address. Both overloads: the SDK defines this one with nn::socket::InAddr and the generation above with in_addr, and a game
+// calls whichever its SDK has. Super Smash Bros. Ultimate's is the InAddr one, which went unhooked, so the game ran the SDK's own: that asks the
+// nifm service over IPC, which is not answered here, and the game went online believing its address to be 0.0.0.0. Its NAT check carried that
+// address, and Pia, with no address of its own to put in a station URL, gave up before it ever reached the other player
 HLE_FORCE("_ZN2nn4nifm26GetCurrentPrimaryIpAddressEP7in_addr", "offline: no IP (SDK 10 overload; online: the host's)", Result, h_nifm_GetIp10, uint32_t *a) {
     uint32_t ip = dm_net_online() ? nx_local_ip() : 0;
     if (a) *a = htonl(ip);
     return ip ? RES_OK : RES_FAIL;
 }
-// SDK 21 (Star Fox): the IPv4 and IPv6 configurations at once, with their counts
 HLE_FORCE("_ZN2nn4nifm18GetCurrentIpConfigEPNS0_10Ipv4ConfigEPiPNS0_10Ipv6ConfigES3_ii", "offline: no IP configuration (SDK 21 overload)", Result, h_nifm_IpCfg21,
           void *v4, int *n4, void *v6, int *n6, int c4, int c6) { (void)v4; (void)v6; (void)c4; (void)c6; if (n4) *n4 = 0; if (n6) *n6 = 0; return RES_FAIL; }
 // EnvironmentIdentifier = char[8]: retail environment "lp1"
@@ -210,7 +213,9 @@ static void *err_variant_pass(void *v, const uint32_t *a, const char *sym, void
     if (!*looked) { *orig = (void *(*)(void *, const uint32_t *))guest_sym(sym); *looked = 1; }
     uint32_t w0 = a ? a[0] : 0, w1 = a && code ? a[1] : 0;
     static _Atomic int n;
-    if ((w0 || w1) && dm_net_online() && atomic_fetch_add(&n, 1) < 200) {
+    static _Atomic uint64_t last;   // the game records the same ordinary result over and over while all is well; a run of one code is logged once
+    uint64_t this = (uint64_t)code << 62 | (uint64_t)w1 << 32 | w0;
+    if ((w0 || w1) && dm_net_online() && atomic_exchange(&last, this) != this && atomic_fetch_add(&n, 1) < 200) {
         if (code) LOG("[nextendo] the game records a failure: error code %04u-%04u", w0, w1);
         else LOG("[nextendo] the game records a failure: result %#x = %04u-%04u", w0, 2000 + (w0 & 0x1ff), (w0 >> 9) & 0x1fff);
     }
diff --git a/docs/nextendo.md b/docs/nextendo.md
