 // ---------- ssl: offline, Initialize and a context's Create / Destroy succeed, everything else that contacts the service fails ----------
 // A context is a session of the local ssl service, so on Horizon Create works with no network and only a connection needs one; DRAGON QUEST BUILDERS 2 ends its startup when Create fails (main+0x861260).
 // Not cut: Context / Connection construction and destruction, Context::GetContextId (only read and write game objects).
+// Online (net_online.h): a connection is the game's socket with the TLS left to the bridge. The handshake of a socket connected to Nextendo's game server puts
+// a bridge's local socket in the host socket's place (the plain TCP connection it replaces is closed), asking for the host name the game set; after
+// that Read and Write are the socket's own, in plain bytes. The bridge checks the server's key against the pin, so the game's own certificate
+// choices (SetVerifyOption, the PKI calls) decide nothing. A handshake to any other address fails
+enum { SSL_WOULD_BLOCK = 0x1987B, SSL_TIMEOUT = 0x19A7B };   // nn::ssl::ResultIoWouldBlock (2123-0204), ResultIoTimeout (2123-0205)
+typedef struct { int fd, nonblock, keep_socket, shook; uint32_t last; char host[256]; } on_ssl;
+static on_ssl *ssl_of(void *self) { return dm_net_online() ? objmap_get(self) : NULL; }
+static Result on_ssl_handshake(on_ssl *c) {
+    if (c->shook) return RES_OK;
+    int h = on_host(c->fd, NULL, NULL, NULL, NULL);
+    if (h < 0) return c->last = RES_FAIL;
+    struct sockaddr_in in; socklen_t il = sizeof in;
+    if (getpeername(h, (struct sockaddr *)&in, &il) || !nx_is_server(ntohl(in.sin_addr.s_addr))) {
+        NXLOG("ssl: handshake on socket %d refused: not connected to the game server", c->fd);
+        return c->last = RES_FAIL;
+    }
+    int b = nx_bridge_open(c->host, 0);
+    if (b < 0) return c->last = RES_FAIL;
+    if (dup2(b, h) < 0) { close(b); return c->last = RES_FAIL; }
+    close(b);
+    fcntl(h, F_SETFL, fcntl(h, F_GETFL) | O_NONBLOCK);
+    pthread_mutex_lock(&g_efd_m); if (sk_used(c->fd)) g_efd[c->fd].bridge = 1; pthread_mutex_unlock(&g_efd_m);
+    c->shook = 1;
+    NXLOG("ssl: socket %d goes through the bridge (%s)", c->fd, c->host[0] ? c->host : "the game's server name");
+    return RES_OK;
+}
+// Read / Peek / Write: the count, or -1 with the connection's last error set (would block, for a connection in non-blocking mode)
+static int on_ssl_io(on_ssl *c, void *b, unsigned n, int peek, int wr) {
+    if (!c->shook) { c->last = RES_FAIL; return -1; }
+    int fl = c->nonblock ? SK_MSG_DONTWAIT : 0;
+    long r = wr ? on_send(c->fd, b, n, fl, NULL, 0) : on_recv(c->fd, b, n, fl | (peek ? MSG_PEEK : 0), NULL, NULL);
+    if (r >= 0) { c->last = RES_OK; return (int)r; }
+    c->last = t_skerr == EAGAIN ? SSL_WOULD_BLOCK : RES_FAIL;
+    return -1;
+}
+static Result on_ssl_poll(on_ssl *c, uint32_t *out, const uint32_t *in, unsigned ms) {   // PollEvent: 1 read, 2 write, 4 except
+    uint32_t want = in ? *in : 0;
+    sk_pollfd p = {c->fd, (int16_t)((want & 1 ? SK_POLLIN : 0) | (want & 2 ? SK_POLLOUT : 0)), 0};
+    int r = on_poll(&p, 1, (int)ms);
+    uint32_t got = (p.revents & (SK_POLLIN | SK_POLLRDNORM) ? 1 : 0) | (p.revents & SK_POLLOUT ? 2 : 0) | (p.revents & (POLLERR | POLLHUP | SK_POLLNVAL) ? 4 : 0);
+    if (out) *out = got;
+    return r > 0 ? RES_OK : SSL_TIMEOUT;
+}
